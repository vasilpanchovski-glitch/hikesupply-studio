 "lines": [
  {
   "text": "Dana checked the forecast the night before.",
   "start": 0.3,
   "end": 2.41
  },
  {
   "text": "By noon on the ridge, the wind picked up and gray clouds rolled in fast.",
   "start": 2.61,
   "end": 6.673
  },
  {
   "text": "In fall, mountain weather can turn in a few hours.",
   "start": 6.923,
   "end": 9.802
  },
  {
   "text": "Here's the fix. Check the forecast again on the morning drive, for the mountain, not the town below.",
   "start": 10.302,
   "end": 16.077
  },
  {
   "text": "Decide your turnaround signs before you start, like rising wind or dark clouds.",
   "start": 16.327,
   "end": 21.402
  },
  {
   "text": "She turned back early and beat the rain.",
   "start": 21.902,
   "end": 23.808
  },
  {
   "text": "Save this before your next fall hike.",
   "start": 24.308,
   "end": 26.207
  }
 ],
