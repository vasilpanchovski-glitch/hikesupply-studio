 "lines": [
  {
   "text": "Last summer Jess tried to book a lakeside campsite two weeks out.",
   "start": 0.4,
   "end": 3.948
  },
  {
   "text": "Every weekend was full.",
   "start": 4.398,
   "end": 5.623
  },
  {
   "text": "So this December she started early.",
   "start": 6.073,
   "end": 8.004
  },
  {
   "text": "Many popular campgrounds open bookings months ahead, and summer weekends go fast.",
   "start": 8.454,
   "end": 13.576
  },
  {
   "text": "She picked the park, wrote down when booking opens, and set a reminder.",
   "start": 14.026,
   "end": 17.991
  },
  {
   "text": "Then the fun part: meals planned, a car packing list, a checklist for the kids.",
   "start": 18.441,
   "end": 23.087
  },
  {
   "text": "One planner, one evening.",
   "start": 23.537,
   "end": 25.055
  },
  {
   "text": "Save this before summer weekends fill up.",
   "start": 25.505,
   "end": 27.479
  }
 ],
