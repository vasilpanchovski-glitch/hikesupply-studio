{
 "duration": 26.779,
 "lines": [
  {
   "text": "Ben planted his trekking pole on a smooth rock slab, leaned his weight on it,",
   "start": 0.4,
   "end": 4.84
  },
  {
   "text": "and the metal tip skidded right out from under him.",
   "start": 4.99,
   "end": 7.408
  },
  {
   "text": "He caught himself, just barely.",
   "start": 7.708,
   "end": 9.349
  },
  {
   "text": "Here's the fix.",
   "start": 9.749,
   "end": 10.676
  },
  {
   "text": "On bare rock, pavement and boardwalks, push a rubber tip onto each pole.",
   "start": 11.026,
   "end": 15.302
  },
  {
   "text": "It grips hard surfaces and stops the clicking and scratching.",
   "start": 15.552,
   "end": 18.929
  },
  {
   "text": "On mud, snow and ice, pull it off so the metal tip bites.",
   "start": 19.229,
   "end": 22.847
  },
  {
   "text": "Carry spares.",
   "start": 23.097,
   "end": 23.95
  },
  {
   "text": "Save this before your next rocky hike.",
   "start": 24.65,
   "end": 26.579
  }
 ],
