{
 "duration": 25.9,
 "lines": [
  {
   "text": "Ana needs a small gift for her hiking friend, something that fits a stocking.",
   "start": 0.4,
   "end": 4.725
  },
  {
   "text": "She prints one sheet of paper.",
   "start": 5.325,
   "end": 6.892
  },
  {
   "text": "Three folds, one cut, no glue, and it becomes an eight-page trail log that slips into a shirt pocket.",
   "start": 7.442,
   "end": 13.992
  },
  {
   "text": "Five hikes, a line for the weather, the view and the snack verdict.",
   "start": 14.542,
   "end": 18.009
  },
  {
   "text": "On the back page she writes a promise: a hike together.",
   "start": 18.559,
   "end": 21.487
  },
  {
   "text": "Her friend fills it by March.",
   "start": 22.037,
   "end": 23.625
  },
  {
   "text": "Save this for your gift list.",
   "start": 24.275,
   "end": 25.7
  }
 ],
