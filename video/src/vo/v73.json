{
 "duration": 24.775,
 "lines": [
  {
   "text": "Ben reaches the summit, grabs his water bottle, and the lid won't turn.",
   "start": 0.3,
   "end": 4.213
  },
  {
   "text": "Water freezes at the top first, right where the lid screws on.",
   "start": 4.513,
   "end": 7.902
  },
  {
   "text": "Here's the fix. Fill up with warm water, not hot.",
   "start": 8.252,
   "end": 11.176
  },
  {
   "text": "Pack the bottle upside down, so the ice forms at the bottom instead.",
   "start": 11.376,
   "end": 15.281
  },
  {
   "text": "Keep it inside your pack, close to your back, not in the side pocket.",
   "start": 15.481,
   "end": 19.323
  },
  {
   "text": "Ben twists the lid open and drinks at the top.",
   "start": 19.673,
   "end": 22.244
  },
  {
   "text": "Save this before your next cold hike.",
   "start": 22.544,
   "end": 24.575
  }
 ],
