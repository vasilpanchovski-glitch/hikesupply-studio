{
 "duration": 27.016,
 "lines": [
  {
   "text": "Sam drove into the Smokies for the fall colors. No entrance gate, no fee.",
   "start": 0.3,
   "end": 5.01
  },
  {
   "text": "He pulled into a trailhead lot, then noticed every other car had a tag on the dashboard.",
   "start": 5.21,
   "end": 10.058
  },
  {
   "text": "In this park, any car parked for more than fifteen minutes needs a parking tag.",
   "start": 10.408,
   "end": 14.515
  },
  {
   "text": "Here's the fix. Buy a daily, weekly or annual tag before you go,",
   "start": 14.815,
   "end": 19.202
  },
  {
   "text": "because most trailheads have no tag machine.",
   "start": 19.352,
   "end": 21.814
  },
  {
   "text": "Next morning, Sam's tag sat on the dash.",
   "start": 22.214,
   "end": 24.687
  },
  {
   "text": "Save this before your Smokies trip.",
   "start": 25.087,
   "end": 26.816
  }
 ],
