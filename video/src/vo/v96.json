{
 "duration": 25.422,
 "lines": [
  {
   "text": "Luis stepped into a slushy puddle at mile two.",
   "start": 0.5,
   "end": 3.064
  },
  {
   "text": "By lunch, his toes were numb.",
   "start": 3.664,
   "end": 5.229
  },
  {
   "text": "Wet socks pull heat out of your feet fast.",
   "start": 6.029,
   "end": 8.249
  },
  {
   "text": "Here's the fix. Carry a dry spare pair of wool socks in a sealed bag.",
   "start": 9.049,
   "end": 13.239
  },
  {
   "text": "At the break, dry your feet and pull on the spare pair.",
   "start": 13.839,
   "end": 16.658
  },
  {
   "text": "Wool still keeps you warmer than cotton when it gets damp.",
   "start": 17.258,
   "end": 20.003
  },
  {
   "text": "He hiked out with warm toes.",
   "start": 20.803,
   "end": 22.367
  },
  {
   "text": "Save this before your next cold hike.",
   "start": 23.167,
   "end": 25.222
  }
 ],
