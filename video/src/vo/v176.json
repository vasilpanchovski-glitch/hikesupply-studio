 "lines": [
  {
   "text": "Her boots froze solid overnight,",
   "start": 0.3,
   "end": 2.075
  },
  {
   "text": "and she couldn't get her feet in.",
   "start": 2.175,
   "end": 3.532
  },
  {
   "text": "The fix: loosen the laces, bag the boots,",
   "start": 3.832,
   "end": 6.307
  },
  {
   "text": "and keep them inside the tent,",
   "start": 6.407,
   "end": 7.909
  },
  {
   "text": "or in your sleeping bag in deep cold.",
   "start": 8.009,
   "end": 10.026
  },
  {
   "text": "Save this before your first winter night out.",
   "start": 10.376,
   "end": 12.558
  }
 ],
