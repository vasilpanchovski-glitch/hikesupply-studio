{
 "duration": 26.617,
 "lines": [
  {
   "text": "Halfway up the ridge, Nora's bottle was empty.",
   "start": 0.3,
   "end": 3.011
  },
  {
   "text": "The creek beside her looked crystal clear, so she knelt to drink.",
   "start": 3.311,
   "end": 6.568
  },
  {
   "text": "Her hiking partner stopped her.",
   "start": 6.868,
   "end": 8.455
  },
  {
   "text": "Clear water can still carry bacteria and parasites you can't see.",
   "start": 8.755,
   "end": 12.451
  },
  {
   "text": "Here's the fix.",
   "start": 12.851,
   "end": 13.778
  },
  {
   "text": "Carry a filter straw, drink through it, or fill your bottle and filter as you go.",
   "start": 14.079,
   "end": 18.631
  },
  {
   "text": "Choose flowing water away from trails and campsites.",
   "start": 18.931,
   "end": 21.72
  },
  {
   "text": "Nora drank, and the hike went on.",
   "start": 22.17,
   "end": 24.012
  },
  {
   "text": "Save this before your next long hike.",
   "start": 24.462,
   "end": 26.417
  }
 ],
