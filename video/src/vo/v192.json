 "lines": [
  {
   "text": "Nick wore two pairs of cotton socks for the cold walk.",
   "start": 0.3,
   "end": 3.125
  },
  {
   "text": "Tight boots, damp cotton, and his toes went numb.",
   "start": 3.375,
   "end": 6.121
  },
  {
   "text": "Squeezed feet get less warm blood.",
   "start": 6.371,
   "end": 8.205
  },
  {
   "text": "The rule: one good wool pair with room to wiggle your toes.",
   "start": 8.455,
   "end": 11.653
  },
  {
   "text": "Save this before winter.",
   "start": 11.903,
   "end": 13.217
  }
 ],
