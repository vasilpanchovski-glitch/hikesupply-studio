{
 "duration": 28.955,
 "lines": [
  {
   "text": "Lena planned a winter trip to Yosemite from the east.",
   "start": 0.4,
   "end": 3.34
  },
  {
   "text": "On the way up to Tioga Pass, she hit a locked gate.",
   "start": 3.54,
   "end": 6.481
  },
  {
   "text": "That high road closes for winter, usually from November until late spring.",
   "start": 6.681,
   "end": 11.329
  },
  {
   "text": "Here's the fix.",
   "start": 11.629,
   "end": 12.556
  },
  {
   "text": "In winter, drive in from the west, carry tire chains, and check road status on nps.gov the morning you go.",
   "start": 12.756,
   "end": 20.185
  },
  {
   "text": "Yosemite Valley stays open all year.",
   "start": 20.385,
   "end": 22.581
  },
  {
   "text": "Next day, Lena walked to Lower Yosemite Fall in fresh snow.",
   "start": 22.881,
   "end": 26.415
  },
  {
   "text": "Save this before your Yosemite trip.",
   "start": 26.815,
   "end": 28.755
  }
 ],
