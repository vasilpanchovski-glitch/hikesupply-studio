{
 "duration": 27.637,
 "lines": [
  {
   "text": "Dan drove into Zion at ten in the morning.",
   "start": 0.3,
   "end": 2.533
  },
  {
   "text": "The visitor center lot was full, and the canyon road was closed to cars.",
   "start": 2.733,
   "end": 6.902
  },
  {
   "text": "While the shuttle runs, hikers ride it to the trailheads.",
   "start": 7.102,
   "end": 10.187
  },
  {
   "text": "Here's the fix.",
   "start": 10.537,
   "end": 11.464
  },
  {
   "text": "Arrive before eight, park, and catch an early shuttle.",
   "start": 11.714,
   "end": 14.704
  },
  {
   "text": "If the lot is full, park in Springdale and ride the free town shuttle when it's running.",
   "start": 14.904,
   "end": 19.639
  },
  {
   "text": "Check nps.gov for this season's schedule.",
   "start": 19.839,
   "end": 22.661
  },
  {
   "text": "Next morning, Dan's trail was quiet.",
   "start": 23.061,
   "end": 25.266
  },
  {
   "text": "Save this before your Zion trip.",
   "start": 25.666,
   "end": 27.437
  }
 ],
