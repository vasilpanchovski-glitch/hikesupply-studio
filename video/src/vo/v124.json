{
 "duration": 23.885,
 "lines": [
  {
   "text": "Rain cancels the Saturday hike, and Mia is bored.",
   "start": 0.4,
   "end": 3.29
  },
  {
   "text": "Her dad prints one sheet of paper.",
   "start": 3.69,
   "end": 5.486
  },
  {
   "text": "Three folds, one cut, and Mia has her own pocket trail log, small enough for a jacket pocket.",
   "start": 5.886,
   "end": 11.887
  },
  {
   "text": "On Sunday she takes it up the trail:",
   "start": 12.387,
   "end": 14.384
  },
  {
   "text": "the weather, the best view, what she heard, a sketch at the top.",
   "start": 14.584,
   "end": 17.6
  },
  {
   "text": "By spring she has filled two booklets, and asks to print a third.",
   "start": 18.1,
   "end": 21.466
  },
  {
   "text": "Save this for the next rainy day.",
   "start": 21.966,
   "end": 23.685
  }
 ],
