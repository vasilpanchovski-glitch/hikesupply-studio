 "lines": [
  {
   "text": "Jess starts up in sunshine, in trail runners.",
   "start": 0.3,
   "end": 3.086
  },
  {
   "text": "Two thousand feet higher, the path is buried in snow and her shoes are soaked.",
   "start": 3.336,
   "end": 7.676
  },
  {
   "text": "In November, conditions can change as you climb.",
   "start": 7.926,
   "end": 10.843
  },
  {
   "text": "Here's the fix. Call the ranger station or check the trail report",
   "start": 11.193,
   "end": 15.168
  },
  {
   "text": "for the upper miles, not just the trailhead.",
   "start": 15.268,
   "end": 17.513
  },
  {
   "text": "Pack warm layers, and agree on a turnaround if you hit snow.",
   "start": 17.813,
   "end": 21.208
  },
  {
   "text": "Next time, Jess turns at the snow line, dry.",
   "start": 21.558,
   "end": 24.334
  },
  {
   "text": "Save this before your next climb.",
   "start": 24.634,
   "end": 26.35
  }
 ],
