{
 "duration": 27.221,
 "lines": [
  {
   "text": "Black Friday.",
   "start": 0.4,
   "end": 1.282
  },
  {
   "text": "Ana's family was ready for the mall.",
   "start": 1.663,
   "end": 3.544
  },
  {
   "text": "She took them to a trail instead.",
   "start": 3.924,
   "end": 5.555
  },
  {
   "text": "Here's the fix. Pick a trail shorter than you think.",
   "start": 6.055,
   "end": 8.654
  },
  {
   "text": "Check the forecast.",
   "start": 9.034,
   "end": 10.086
  },
  {
   "text": "Dress everyone in layers, not cotton.",
   "start": 10.466,
   "end": 12.533
  },
  {
   "text": "Tell someone where you're going.",
   "start": 12.913,
   "end": 14.241
  },
  {
   "text": "And be back well before dark, because the sun sets early now.",
   "start": 14.621,
   "end": 18.032
  },
  {
   "text": "They ended at a lookout, laughing.",
   "start": 18.532,
   "end": 20.238
  },
  {
   "text": "Our Beginner's Hiking Guide is twenty-five percent off through December first.",
   "start": 20.738,
   "end": 25.005
  },
  {
   "text": "Save this for your next free day.",
   "start": 25.385,
   "end": 27.021
  }
 ],
