 "lines": [
  {
   "text": "Ava was heading down.",
   "start": 0.2,
   "end": 1.438
  },
  {
   "text": "A man was huffing up.",
   "start": 1.558,
   "end": 2.609
  },
  {
   "text": "They both stopped, both stepped aside, and nobody moved.",
   "start": 2.729,
   "end": 5.913
  },
  {
   "text": "The trail rule: hikers going downhill step aside for hikers coming up.",
   "start": 6.033,
   "end": 10.164
  },
  {
   "text": "Bikes yield to hikers, everyone yields to horses.",
   "start": 10.284,
   "end": 13.439
  },
  {
   "text": "Save this for your next hike.",
   "start": 13.559,
   "end": 15.0
  }
