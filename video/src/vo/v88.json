 "lines": [
  {
   "text": "Sam drove three hours to a national park with her dog, Juniper.",
   "start": 0.3,
   "end": 4.052
  },
  {
   "text": "At the trailhead, a sign: no pets on trails.",
   "start": 4.352,
   "end": 7.16
  },
  {
   "text": "Most national parks allow dogs only on a few trails, roads and campgrounds.",
   "start": 7.56,
   "end": 12.429
  },
  {
   "text": "Here's the fix. Check the park's pets page before you go.",
   "start": 12.879,
   "end": 16.289
  },
  {
   "text": "National forests and many state parks allow leashed dogs on far more trails.",
   "start": 16.639,
   "end": 21.296
  },
  {
   "text": "The next weekend, Juniper hit the trail.",
   "start": 21.796,
   "end": 24.039
  },
  {
   "text": "Save this before your next dog hike.",
   "start": 24.489,
   "end": 26.323
  }
 ],
