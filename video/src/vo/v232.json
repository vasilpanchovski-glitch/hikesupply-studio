 "lines": [
  {
   "text": "It was cold, so Leo packed no water for his dog.",
   "start": 0.3,
   "end": 3.254
  },
  {
   "text": "By mile three she was licking snow at every stop.",
   "start": 3.354,
   "end": 6.132
  },
  {
   "text": "Dogs still need water in winter.",
   "start": 6.282,
   "end": 8.025
  },
  {
   "text": "Carry a bottle for them and offer sips at each break.",
   "start": 8.125,
   "end": 10.981
  },
  {
   "text": "Save this for your next hike.",
   "start": 11.281,
   "end": 12.722
  }
