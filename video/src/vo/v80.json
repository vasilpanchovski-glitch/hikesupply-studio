 "lines": [
  {
   "text": "Eli drives to Yellowstone's West Entrance in mid-November, ready for Old Faithful.",
   "start": 0.3,
   "end": 5.17
  },
  {
   "text": "The gate is closed.",
   "start": 5.37,
   "end": 6.458
  },
  {
   "text": "Since November first, most park roads are closed to cars until spring.",
   "start": 6.708,
   "end": 11.043
  },
  {
   "text": "Here's the fix. Enter at the North Entrance in Gardiner.",
   "start": 11.343,
   "end": 14.375
  },
  {
   "text": "The road through Mammoth Hot Springs and Lamar Valley stays open all winter, weather permitting.",
   "start": 14.575,
   "end": 20.058
  },
  {
   "text": "Check road status the morning you go.",
   "start": 20.308,
   "end": 22.207
  },
  {
   "text": "Eli watches bison in Lamar Valley from a safe distance.",
   "start": 22.507,
   "end": 25.673
  },
  {
   "text": "Save this before your winter trip.",
   "start": 25.923,
   "end": 27.494
  }
 ],
