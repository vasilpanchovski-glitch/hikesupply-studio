{
 "duration": 26.09,
 "lines": [
  {
   "text": "Leo pulled his boot laces tight in the cold parking lot.",
   "start": 0.4,
   "end": 3.805
  },
  {
   "text": "Snap.",
   "start": 4.005,
   "end": 4.533
  },
  {
   "text": "The lace had been fraying at the top hook for months.",
   "start": 4.733,
   "end": 7.243
  },
  {
   "text": "He knotted the two short ends together and walked the whole hike in a loose, sloppy boot.",
   "start": 7.443,
   "end": 12.173
  },
  {
   "text": "Here's the fix.",
   "start": 12.373,
   "end": 13.3
  },
  {
   "text": "Before winter, run your fingers along each lace where it rubs the eyelets.",
   "start": 13.5,
   "end": 17.683
  },
  {
   "text": "Fuzzy or thin? Replace both.",
   "start": 17.883,
   "end": 19.559
  },
  {
   "text": "Carry one spare lace in your pack.",
   "start": 19.759,
   "end": 21.394
  },
  {
   "text": "Next weekend, his boots held tight.",
   "start": 21.594,
   "end": 23.803
  },
  {
   "text": "Save this before your next hike.",
   "start": 24.203,
   "end": 25.89
  }
 ],
