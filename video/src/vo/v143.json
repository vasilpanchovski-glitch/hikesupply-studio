{
 "duration": 25.794,
 "lines": [
  {
   "text": "Grace tied her hair up for the climb and pulled a beanie over the top.",
   "start": 0.4,
   "end": 3.883
  },
  {
   "text": "It kept riding up, and the wind found her ears.",
   "start": 4.383,
   "end": 7.183
  },
  {
   "text": "She finally stuffed it in her pocket.",
   "start": 7.683,
   "end": 9.525
  },
  {
   "text": "Here's the fix.",
   "start": 10.025,
   "end": 10.952
  },
  {
   "text": "Wear a fleece ear warmer headband.",
   "start": 11.452,
   "end": 13.242
  },
  {
   "text": "It sits under the ponytail, covers your ears and forehead, and stays put.",
   "start": 13.742,
   "end": 17.918
  },
  {
   "text": "The top of your head can still let out heat on the climb.",
   "start": 18.418,
   "end": 21.24
  },
  {
   "text": "Warm ears at the top.",
   "start": 21.74,
   "end": 22.963
  },
  {
   "text": "Save this before your next cold hike.",
   "start": 23.563,
   "end": 25.594
  }
 ],
