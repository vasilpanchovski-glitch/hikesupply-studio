 "lines": [
  {
   "text": "Two days before the holidays, Mark realized he had nothing for Dan,",
   "start": 0.4,
   "end": 4.374
  },
  {
   "text": "the friend who drags him up every trail.",
   "start": 4.824,
   "end": 6.875
  },
  {
   "text": "No time left for shipping.",
   "start": 7.325,
   "end": 8.808
  },
  {
   "text": "So he printed Dan a whole year of hiking:",
   "start": 9.258,
   "end": 11.575
  },
  {
   "text": "a planner with a hike for every month, and a hike-a-week challenge.",
   "start": 12.025,
   "end": 15.601
  },
  {
   "text": "He wrote their first trail on the gift page and cut out the tag.",
   "start": 16.051,
   "end": 19.259
  },
  {
   "text": "On January first, they were at the trailhead together.",
   "start": 19.709,
   "end": 22.545
  },
  {
   "text": "Save this for your gift list.",
   "start": 22.995,
   "end": 24.421
  }
 ],
