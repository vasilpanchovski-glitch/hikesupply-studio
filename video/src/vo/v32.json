{
 "duration": 24.022,
 "lines": [
  {
   "text": "Jake starts down a steep, loose descent and leans on his pole.",
   "start": 0.3,
   "end": 3.857
  },
  {
   "text": "It slides shorter and he stumbles.",
   "start": 4.057,
   "end": 5.881
  },
  {
   "text": "Before you head down, do the five-second pole check.",
   "start": 6.231,
   "end": 9.078
  },
  {
   "text": "Set the length, close every lock all the way,",
   "start": 9.378,
   "end": 11.735
  },
  {
   "text": "then press your full weight into the pole on flat ground.",
   "start": 11.885,
   "end": 14.754
  },
  {
   "text": "If it moves, tighten it and test again.",
   "start": 14.954,
   "end": 17.121
  },
  {
   "text": "Now Jake heads down on a pole that holds, and rechecks it at every break.",
   "start": 17.521,
   "end": 21.666
  },
  {
   "text": "Save this before your next descent.",
   "start": 22.066,
   "end": 23.822
  }
 ],
