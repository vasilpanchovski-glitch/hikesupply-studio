 "lines": [
  {
   "text": "It's a warm June morning in Banff town, so Jake heads up to Lake Agnes in trail runners.",
   "start": 0.4,
   "end": 5.791
  },
  {
   "text": "An hour later, he's sinking into deep snow.",
   "start": 6.191,
   "end": 8.611
  },
  {
   "text": "Higher trails in the Rockies can stay snowy into July.",
   "start": 9.011,
   "end": 12.242
  },
  {
   "text": "Here's the fix.",
   "start": 12.742,
   "end": 13.669
  },
  {
   "text": "For thawed lakes and open trails, plan late June to mid-September.",
   "start": 13.969,
   "end": 17.804
  },
  {
   "text": "Check Parks Canada trail conditions first, and pack for winter up high.",
   "start": 18.104,
   "end": 22.125
  },
  {
   "text": "Jake returns in August. Dry feet.",
   "start": 22.625,
   "end": 24.98
  },
  {
   "text": "Save this before you plan Banff.",
   "start": 25.48,
   "end": 27.067
  }
 ],
