 "lines": [
  {
   "text": "Ava walked to the ridge edge for a photo.",
   "start": 0.3,
   "end": 2.407
  },
  {
   "text": "Under her boots was no rock, only wind-blown snow hanging over the drop.",
   "start": 2.507,
   "end": 6.771
  },
  {
   "text": "The rule: on snowy ridges, stay well back and stand where you see rock.",
   "start": 7.021,
   "end": 11.345
  },
  {
   "text": "Save this before your next ridge.",
   "start": 11.645,
   "end": 13.36
  }
