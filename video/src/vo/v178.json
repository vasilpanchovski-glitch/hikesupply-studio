  {
   "text": "Each finger above the horizon is about fifteen minutes.",
   "start": 6.726,
   "end": 9.911
  },
  {
   "text": "Turn around early.",
   "start": 10.061,
   "end": 11.095
  },
  {
   "text": "Save this for your next afternoon hike.",
   "start": 11.445,
   "end": 13.372
