  {
   "text": "Ben thought he had an hour of light left.",
   "start": 0.3,
   "end": 2.357
  },
  {
   "text": "He had twenty minutes.",
   "start": 2.457,
   "end": 3.555
  },
  {
   "text": "A rough check: hold your hand out flat under the sun.",
   "start": 3.855,
   "end": 6.626
