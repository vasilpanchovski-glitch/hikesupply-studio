{
 "duration": 24.242,
 "lines": [
  {
   "text": "On a crisp fall morning, Mark barely touched his water.",
   "start": 0.3,
   "end": 3.33
  },
  {
   "text": "It was cold, so he didn't feel thirsty.",
   "start": 3.53,
   "end": 5.806
  },
  {
   "text": "By the last mile he had a headache and heavy legs.",
   "start": 6.106,
   "end": 8.734
  },
  {
   "text": "Cold air dulls your thirst, but you still sweat and breathe out water.",
   "start": 9.034,
   "end": 12.714
  },
  {
   "text": "Here's the fix.",
   "start": 13.014,
   "end": 13.941
  },
  {
   "text": "Carry water where you can reach it,",
   "start": 14.241,
   "end": 15.88
  },
  {
   "text": "and sip every fifteen or twenty minutes, thirsty or not.",
   "start": 16.03,
   "end": 19.414
  },
  {
   "text": "Mark finished his next hike strong.",
   "start": 19.814,
   "end": 21.611
  },
  {
   "text": "Save this before your next cold hike.",
   "start": 22.011,
   "end": 24.042
  }
 ],
