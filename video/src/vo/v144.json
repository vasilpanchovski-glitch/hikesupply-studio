 "lines": [
  {
   "text": "After a day in Glacier, Nina drove north for Banff.",
   "start": 0.4,
   "end": 3.385
  },
  {
   "text": "At the small border crossing near the park, the gate was down.",
   "start": 3.585,
   "end": 6.834
  },
  {
   "text": "Here's the fix.",
   "start": 7.034,
   "end": 7.961
  },
  {
   "text": "The crossings near Glacier keep short or seasonal hours, so check the border hours before you leave.",
   "start": 8.161,
   "end": 14.076
  },
  {
   "text": "Carry a passport or other accepted travel document for everyone in the car.",
   "start": 14.276,
   "end": 18.84
  },
  {
   "text": "Book your nights around the crossing you'll use.",
   "start": 19.04,
   "end": 21.316
  },
  {
   "text": "Next summer, she crossed in daylight.",
   "start": 21.516,
   "end": 23.515
  },
  {
   "text": "Save this while you plan.",
   "start": 23.915,
   "end": 25.251
  }
 ],
