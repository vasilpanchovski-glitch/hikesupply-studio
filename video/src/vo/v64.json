{
 "duration": 24.217,
 "lines": [
  {
   "text": "Jake walked toward a Yellowstone bison for a photo.",
   "start": 0.3,
   "end": 3.289
  },
  {
   "text": "It looked calm and slow.",
   "start": 3.489,
   "end": 4.728
  },
  {
   "text": "Then it lifted its head and stared at him.",
   "start": 4.928,
   "end": 7.102
  },
  {
   "text": "Bison are fast, and they hurt visitors who get too close.",
   "start": 7.402,
   "end": 10.636
  },
  {
   "text": "Here's the fix. The park asks you to stay at least twenty-five yards from bison and elk,",
   "start": 11.086,
   "end": 15.989
  },
  {
   "text": "and one hundred yards from bears and wolves.",
   "start": 16.139,
   "end": 18.301
  },
  {
   "text": "Use your zoom.",
   "start": 18.551,
   "end": 19.475
  },
  {
   "text": "He got the shot from a safe distance.",
   "start": 19.875,
   "end": 21.692
  },
  {
   "text": "Save this before your Yellowstone trip.",
   "start": 22.092,
   "end": 24.017
  }
 ],
