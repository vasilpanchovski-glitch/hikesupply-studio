{
 "duration": 28.088,
 "lines": [
  {
   "text": "Priya plans her first Banff trip around one photo: Moraine Lake at sunrise.",
   "start": 0.4,
   "end": 4.996
  },
  {
   "text": "Then she reads the fine print.",
   "start": 5.396,
   "end": 6.928
  },
  {
   "text": "Moraine Lake Road is closed to personal vehicles all year. No parking, no exceptions.",
   "start": 7.228,
   "end": 12.823
  },
  {
   "text": "Here's the fix.",
   "start": 13.323,
   "end": 14.25
  },
  {
   "text": "Plan on the Parks Canada shuttle from the Lake Louise Park and Ride,",
   "start": 14.55,
   "end": 18.48
  },
  {
   "text": "and book it on the official Parks Canada site the day seats open in spring.",
   "start": 18.68,
   "end": 23.095
  },
  {
   "text": "Priya gets her seat, and her sunrise.",
   "start": 23.595,
   "end": 25.802
  },
  {
   "text": "Save this before you plan Banff.",
   "start": 26.302,
   "end": 27.888
  }
 ],
