{
 "duration": 23.042,
 "lines": [
  {
   "text": "Maya zipped her fleece to the chin at the trailhead.",
   "start": 0.3,
   "end": 2.721
  },
  {
   "text": "Twenty minutes up, she was soaked in sweat.",
   "start": 2.921,
   "end": 5.065
  },
  {
   "text": "At the windy summit, that wet shirt turned ice cold.",
   "start": 5.265,
   "end": 8.334
  },
  {
   "text": "Here's the fix. Be bold, start cold.",
   "start": 8.784,
   "end": 10.916
  },
  {
   "text": "Begin the climb a little chilly, and take a layer off before you sweat.",
   "start": 11.166,
   "end": 14.903
  },
  {
   "text": "Put your warm layer back on the moment you stop.",
   "start": 15.153,
   "end": 17.364
  },
  {
   "text": "Next climb, Maya stayed dry and warm on top.",
   "start": 17.764,
   "end": 20.587
  },
  {
   "text": "Save this before your next winter hike.",
   "start": 20.987,
   "end": 22.842
  }
 ],
