 "lines": [
  {
   "text": "Maya said yes to a ten-mile hike with friends.",
   "start": 0.3,
   "end": 2.88
  },
  {
   "text": "Her longest hike so far was three miles.",
   "start": 3.08,
   "end": 5.273
  },
  {
   "text": "On the first climb her legs burned and she kept stopping.",
   "start": 5.573,
   "end": 8.713
  },
  {
   "text": "Here's the fix. Start training weeks before.",
   "start": 9.163,
   "end": 11.666
  },
  {
   "text": "Five short sessions a week: walks, hills and simple strength moves like step-ups.",
   "start": 11.916,
   "end": 16.697
  },
  {
   "text": "Add a little distance each week, never all at once.",
   "start": 16.947,
   "end": 19.734
  },
  {
   "text": "On the next big day, she reached the top with her friends.",
   "start": 20.134,
   "end": 22.961
  },
  {
   "text": "Save this before you book your next big hike.",
   "start": 23.361,
   "end": 25.611
  }
 ],
