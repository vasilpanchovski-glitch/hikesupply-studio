 "lines": [
  {
   "text": "It's January, so Nora thought the bears were asleep.",
   "start": 0.3,
   "end": 3.072
  },
  {
   "text": "One was by the trail.",
   "start": 3.172,
   "end": 4.395
  },
  {
   "text": "In the Smokies, bears may leave their dens on warm winter days.",
   "start": 4.645,
   "end": 8.426
  },
  {
   "text": "The rule: stay fifty yards away, and never leave food out.",
   "start": 8.676,
   "end": 12.078
  },
  {
   "text": "Save this before your Smokies trip.",
   "start": 12.378,
   "end": 14.106
  }
