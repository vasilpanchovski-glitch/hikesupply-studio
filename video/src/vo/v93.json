{
 "duration": 27.688,
 "lines": [
  {
   "text": "Mia planned a Thanksgiving drive over Trail Ridge Road.",
   "start": 0.35,
   "end": 3.562
  },
  {
   "text": "The gate was closed.",
   "start": 3.862,
   "end": 4.972
  },
  {
   "text": "It closes to through traffic from mid-October to late May.",
   "start": 5.272,
   "end": 8.521
  },
  {
   "text": "Here's the fix. In winter, stay on the east side and pick lower trails, where the snow is lighter.",
   "start": 8.971,
   "end": 14.798
  },
  {
   "text": "Ask a ranger about snow, ice and avalanche danger.",
   "start": 15.098,
   "end": 18.481
  },
  {
   "text": "Pack poles or traction, layers and food, and start early.",
   "start": 18.781,
   "end": 22.144
  },
  {
   "text": "Days are short.",
   "start": 22.444,
   "end": 23.35
  },
  {
   "text": "She was back in town for dinner.",
   "start": 23.8,
   "end": 25.375
  },
  {
   "text": "Save this before your Rocky trip.",
   "start": 25.825,
   "end": 27.488
  }
 ],
