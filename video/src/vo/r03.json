{
 "duration": 18.609,
 "lines": [
  {
   "text": "Loose rock can slide out from under you.",
   "start": 0.3,
   "end": 2.4
  },
  {
   "text": "On scree, take short steps and keep your weight over your feet.",
   "start": 2.65,
   "end": 5.921
  },
  {
   "text": "Bend your knees a little, and test each step before you trust it.",
   "start": 6.121,
   "end": 9.395
  },
  {
   "text": "Never walk straight below another hiker, and if a rock falls, shout rock!",
   "start": 9.645,
   "end": 13.676
  },
  {
   "text": "Poles give you two extra points of contact.",
   "start": 13.926,
   "end": 16.393
  },
  {
   "text": "Save this before your next climb.",
   "start": 16.693,
   "end": 18.409
  }
 ],
