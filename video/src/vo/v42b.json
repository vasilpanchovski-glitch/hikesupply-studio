  {
   "text": "Last weekend, Josh finished his hike just before dark.",
   "start": 0.3,
   "end": 3.431
  },
  {
   "text": "Today the clocks went back, and the sun set an hour earlier.",
   "start": 3.731,
   "end": 7.059
  },
  {
   "text": "Same start time, same trail, and he walked the last mile in the dark.",
   "start": 7.359,
   "end": 11.554
  },
  {
   "text": "Here's the fix. Check today's sunset, and set a turnaround time that gets you back an hour before it.",
   "start": 11.904,
   "end": 17.768
  },
  {
   "text": "When that time comes, turn around, even if the top is close.",
   "start": 18.068,
   "end": 21.703
  },
  {
   "text": "Next weekend, Josh started earlier.",
   "start": 22.103,
   "end": 24.303
  },
  {
   "text": "Save this before your next fall hike.",
   "start": 24.703,
   "end": 26.602
  }
 ],
