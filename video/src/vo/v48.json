{
 "duration": 25.687,
 "lines": [
  {
   "text": "Five a.m. at a frosty trailhead.",
   "start": 0.3,
   "end": 2.531
  },
  {
   "text": "Jen pulled off her gloves to find the tiny button on her headlamp.",
   "start": 2.731,
   "end": 6.198
  },
  {
   "text": "By the time it turned on, her fingers were numb, and the hike hadn't even started.",
   "start": 6.398,
   "end": 10.643
  },
  {
   "text": "Here's the fix. Keep your gloves on.",
   "start": 11.243,
   "end": 13.244
  },
  {
   "text": "A motion-sensor headlamp turns on and off with a wave of your hand.",
   "start": 13.544,
   "end": 17.339
  },
  {
   "text": "Charge it the night before and pack a spare light on longer hikes.",
   "start": 17.639,
   "end": 21.129
  },
  {
   "text": "Jen started warm.",
   "start": 21.729,
   "end": 22.81
  },
  {
   "text": "Save this before your next early start.",
   "start": 23.41,
   "end": 25.487
  }
 ],
