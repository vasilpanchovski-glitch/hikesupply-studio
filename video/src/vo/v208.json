 "lines": [
  {
   "text": "Going down the snowy trail, Leo leaned back and his feet shot out from under him.",
   "start": 0.3,
   "end": 4.708
  },
  {
   "text": "The rule: on soft snow, keep your weight over your feet, knees bent, pole ahead, heels pressed in.",
   "start": 4.958,
   "end": 10.776
  },
  {
   "text": "On ice, wear traction.",
   "start": 11.076,
   "end": 12.391
  },
  {
   "text": "Save this for winter.",
   "start": 12.691,
   "end": 13.885
  }
