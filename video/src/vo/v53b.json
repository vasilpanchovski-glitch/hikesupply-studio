{
 "duration": 24.983,
 "lines": [
  {
   "text": "Kate reached the overlook warm and sweaty.",
   "start": 0.3,
   "end": 2.4
  },
  {
   "text": "She sat on a rock, ate her lunch, took photos.",
   "start": 2.75,
   "end": 5.376
  },
  {
   "text": "Ten minutes later she was shivering, and the cold stayed with her all the way down.",
   "start": 5.726,
   "end": 9.845
  },
  {
   "text": "Here's the rule. Jacket on, then sit.",
   "start": 10.645,
   "end": 12.786
  },
  {
   "text": "The moment you stop on a cold day, put your warm layer on first, before your body cools.",
   "start": 13.186,
   "end": 18.173
  },
  {
   "text": "Take it off again before you start walking.",
   "start": 18.573,
   "end": 20.851
  },
  {
   "text": "Save this before your next cold hike.",
   "start": 22.751,
   "end": 24.783
  }
 ],
