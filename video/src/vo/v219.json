 "lines": [
  {
   "text": "Ben hiked the open ridge with his face bare to a cold wind.",
   "start": 0.3,
   "end": 3.72
  },
  {
   "text": "By noon his cheeks were raw and stinging.",
   "start": 3.82,
   "end": 5.873
  },
  {
   "text": "The fix takes two seconds:",
   "start": 6.123,
   "end": 7.564
  },
  {
   "text": "pull a gaiter over your nose and cheeks before the wind hits.",
   "start": 7.664,
   "end": 10.865
  },
  {
   "text": "Save this for your next ridge.",
   "start": 11.165,
   "end": 12.679
  }
 ],
