  {
   "text": "Luke hiked to Delicate Arch on a cold December morning.",
   "start": 0.3,
   "end": 3.358
  },
  {
   "text": "The open slickrock had a thin skin of ice.",
   "start": 3.608,
   "end": 5.952
  },
  {
   "text": "Every step slid.",
   "start": 6.202,
   "end": 7.254
  },
  {
   "text": "The rule: in winter, ask at the visitor center about trail ice and bring traction.",
   "start": 7.504,
   "end": 12.449
  },
  {
   "text": "Save this before your Utah winter trip.",
   "start": 12.699,
   "end": 14.574
  }
