 "lines": [
  {
   "text": "Priya's friend asked about the best hike of her fall.",
   "start": 0.3,
   "end": 3.093
  },
  {
   "text": "Golden trees, a waterfall, an easy loop.",
   "start": 3.293,
   "end": 5.699
  },
  {
   "text": "But Priya couldn't remember the trail name, the distance, or where she parked.",
   "start": 5.999,
   "end": 10.022
  },
  {
   "text": "Here's the fix. Take two minutes at the car after every hike.",
   "start": 10.622,
   "end": 14.065
  },
  {
   "text": "Write the date, the trail, the miles, the time it took, the weather, and one thing to pack next time.",
   "start": 14.315,
   "end": 19.618
  },
  {
   "text": "By the end of the year, you have your own guidebook.",
   "start": 20.018,
   "end": 22.445
  },
  {
   "text": "Save this before your next hike.",
   "start": 23.145,
   "end": 24.832
  }
 ],
