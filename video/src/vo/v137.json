{
 "duration": 25.463,
 "lines": [
  {
   "text": "Mia slipped on an icy step and twisted her ankle.",
   "start": 0.4,
   "end": 3.36
  },
  {
   "text": "Her partner was out of sight below.",
   "start": 3.56,
   "end": 5.337
  },
  {
   "text": "She blew her old whistle. Nothing.",
   "start": 5.537,
   "end": 7.579
  },
  {
   "text": "The little ball inside was wet from the morning, and it had frozen stuck.",
   "start": 7.879,
   "end": 11.828
  },
  {
   "text": "Here's the fix.",
   "start": 12.028,
   "end": 12.955
  },
  {
   "text": "Carry a whistle with no ball inside, clip it outside on your pack strap, and shake it dry after rain.",
   "start": 13.155,
   "end": 19.128
  },
  {
   "text": "Three blasts, a pause, repeat.",
   "start": 19.328,
   "end": 21.075
  },
  {
   "text": "Her partner heard her from the switchback.",
   "start": 21.275,
   "end": 23.008
  },
  {
   "text": "Save this before your next winter hike.",
   "start": 23.408,
   "end": 25.263
  }
 ],
