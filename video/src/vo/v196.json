  {
   "text": "Grace wanted a closer photo of the waterfall.",
   "start": 0.3,
   "end": 2.744
  },
  {
   "text": "The rocks looked dry.",
   "start": 2.994,
   "end": 4.181
  },
  {
   "text": "They were covered in a thin film of algae and spray.",
   "start": 4.431,
   "end": 6.921
  },
  {
   "text": "The Smokies rule: never climb on rocks around waterfalls.",
   "start": 7.171,
   "end": 10.73
  },
  {
   "text": "Take the photo from the trail.",
   "start": 10.98,
   "end": 12.565
  },
  {
   "text": "Save this before your Smokies trip.",
   "start": 12.815,
   "end": 14.543
  }
