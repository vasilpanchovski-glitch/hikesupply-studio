 "lines": [
  {
   "text": "The snow looked light, but every step Ava sank to her knee.",
   "start": 0.3,
   "end": 3.439
  },
  {
   "text": "One mile took an hour, and she was soaked in sweat.",
   "start": 3.689,
   "end": 6.428
  },
  {
   "text": "The rule: when snow is deeper than your boot tops,",
   "start": 6.728,
   "end": 9.38
  },
  {
   "text": "wear snowshoes or pick a packed trail.",
   "start": 9.48,
   "end": 11.492
  },
  {
   "text": "Save this for winter.",
   "start": 11.792,
   "end": 12.986
  }
 ],
