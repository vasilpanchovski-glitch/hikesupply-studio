  {
   "text": "Mia was sweating on the climb.",
   "start": 0.3,
   "end": 1.807
  },
  {
   "text": "Her baby, sitting still in the carrier, was getting cold.",
   "start": 2.007,
   "end": 4.975
  },
  {
   "text": "Babies don't warm up by walking.",
   "start": 5.175,
   "end": 6.954
  },
  {
   "text": "The rule: one more layer than you, and check the back of the neck often.",
   "start": 7.204,
   "end": 10.979
  },
  {
   "text": "Save this before your family hike.",
   "start": 11.329,
   "end": 13.143
  }
