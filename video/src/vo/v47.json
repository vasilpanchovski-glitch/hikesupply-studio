{
 "duration": 25.532,
 "lines": [
  {
   "text": "Tom took his daughter Lily on her first fall hike.",
   "start": 0.3,
   "end": 2.905
  },
  {
   "text": "One mile in, she sat down on a log.",
   "start": 3.105,
   "end": 5.352
  },
  {
   "text": "Are we there yet?",
   "start": 5.652,
   "end": 6.582
  },
  {
   "text": "Here's the fix. Give kids a mission, not a distance.",
   "start": 7.182,
   "end": 10.11
  },
  {
   "text": "Hand Lily a scavenger hunt: a red leaf, a pinecone, a mushroom, a trail blaze.",
   "start": 10.41,
   "end": 15.564
  },
  {
   "text": "Let her lead to the next blaze, and stop at every junction.",
   "start": 15.864,
   "end": 19.177
  },
  {
   "text": "Soon she was racing ahead.",
   "start": 19.677,
   "end": 21.116
  },
  {
   "text": "At the car she asked for another hike.",
   "start": 21.316,
   "end": 22.981
  },
  {
   "text": "Save this for your next family hike.",
   "start": 23.581,
   "end": 25.332
  }
 ],
