{
 "duration": 26.7,
 "lines": [
  {
   "text": "Ben led his family up the trail the day after Thanksgiving.",
   "start": 0.3,
   "end": 3.505
  },
  {
   "text": "Twenty minutes in, he turned around.",
   "start": 3.955,
   "end": 5.825
  },
  {
   "text": "Grandpa was out of sight, far behind, alone.",
   "start": 6.175,
   "end": 8.696
  },
  {
   "text": "Here's the fix. Put the slowest hiker in front.",
   "start": 9.296,
   "end": 12.088
  },
  {
   "text": "The group moves at their pace, nobody gets left behind,",
   "start": 12.488,
   "end": 15.666
  },
  {
   "text": "and you can talk the whole way.",
   "start": 15.916,
   "end": 17.352
  },
  {
   "text": "Your most experienced hiker walks last and keeps an eye on everyone.",
   "start": 17.802,
   "end": 21.844
  },
  {
   "text": "They reached the overlook together.",
   "start": 22.444,
   "end": 23.986
  },
  {
   "text": "Save this before your holiday hike.",
   "start": 24.586,
   "end": 26.5
  }
 ],
