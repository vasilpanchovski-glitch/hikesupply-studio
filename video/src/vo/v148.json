 "lines": [
  {
   "text": "After a week in Glacier, Jake drove north to Banff with his U.S. annual park pass on the dashboard.",
   "start": 0.4,
   "end": 6.7
  },
  {
   "text": "At the Canadian park gate, he learned it only works in U.S. parks.",
   "start": 6.9,
   "end": 10.93
  },
  {
   "text": "Here's the fix.",
   "start": 11.13,
   "end": 12.057
  },
  {
   "text": "Canada's national parks need their own Parks Canada pass, bought online or at the gate.",
   "start": 12.257,
   "end": 17.56
  },
  {
   "text": "Check fees and reservations for both parks before you go,",
   "start": 17.76,
   "end": 21.259
  },
  {
   "text": "and carry passports for the border.",
   "start": 21.459,
   "end": 23.07
  },
  {
   "text": "Next summer, both passes were ready.",
   "start": 23.27,
   "end": 25.378
  },
  {
   "text": "Save this while you plan.",
   "start": 25.728,
   "end": 27.064
  }
 ],
