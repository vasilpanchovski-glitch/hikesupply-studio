{
 "duration": 23.507,
 "lines": [
  {
   "text": "Sam laces his boots extra tight for the cold.",
   "start": 0.3,
   "end": 2.83
  },
  {
   "text": "One hour in, his toes are numb.",
   "start": 3.13,
   "end": 4.867
  },
  {
   "text": "Tight boots squeeze the blood flow that keeps feet warm,",
   "start": 5.167,
   "end": 7.892
  },
  {
   "text": "and his socks are damp with sweat.",
   "start": 7.992,
   "end": 9.569
  },
  {
   "text": "Here's the fix. Leave room to wiggle your toes.",
   "start": 9.919,
   "end": 12.681
  },
  {
   "text": "Wear merino socks that stay warm when they get damp,",
   "start": 12.881,
   "end": 15.412
  },
  {
   "text": "and pack a dry spare pair for lunch.",
   "start": 15.512,
   "end": 17.355
  },
  {
   "text": "Sam swaps socks on a rock, and his feet start to warm.",
   "start": 17.705,
   "end": 20.975
  },
  {
   "text": "Save this before your next cold hike.",
   "start": 21.275,
   "end": 23.307
  }
 ],
