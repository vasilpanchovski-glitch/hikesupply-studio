{
 "duration": 24.513,
 "lines": [
  {
   "text": "It was dark by five, and Leo's camp dinner turned into a squinting contest.",
   "start": 0.3,
   "end": 4.709
  },
  {
   "text": "Every time he looked at a friend, his headlamp blinded them.",
   "start": 4.909,
   "end": 8.081
  },
  {
   "text": "Here's the fix. At camp, tilt your headlamp down or switch it off when you talk to people.",
   "start": 8.581,
   "end": 13.758
  },
  {
   "text": "Hang one soft lantern from a tent loop instead, so everyone can see without the glare.",
   "start": 14.008,
   "end": 18.887
  },
  {
   "text": "Same dinner, warm light, nobody squinting.",
   "start": 19.387,
   "end": 21.879
  },
  {
   "text": "Save this before your next camping trip.",
   "start": 22.379,
   "end": 24.313
  }
 ],
