{
 "duration": 24.686,
 "lines": [
  {
   "text": "Rachel slipped on a wet rock and couldn't walk.",
   "start": 0.3,
   "end": 2.599
  },
  {
   "text": "She shouted for help until her voice was gone.",
   "start": 2.899,
   "end": 5.447
  },
  {
   "text": "No one heard.",
   "start": 5.697,
   "end": 6.592
  },
  {
   "text": "Here's the fix.",
   "start": 6.992,
   "end": 7.919
  },
  {
   "text": "A whistle carries much farther than a voice and takes almost no energy.",
   "start": 8.219,
   "end": 12.218
  },
  {
   "text": "Three blasts is the signal for help.",
   "start": 12.468,
   "end": 14.488
  },
  {
   "text": "Wait, then repeat.",
   "start": 14.688,
   "end": 15.838
  },
  {
   "text": "Keep the whistle on your pack strap, not buried inside.",
   "start": 16.088,
   "end": 19.031
  },
  {
   "text": "The next group on the trail heard Rachel's whistle.",
   "start": 19.431,
   "end": 21.981
  },
  {
   "text": "Save this. It could save someone you love.",
   "start": 22.381,
   "end": 24.486
  }
 ],
