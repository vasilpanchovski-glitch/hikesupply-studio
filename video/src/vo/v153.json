{
 "duration": 25.967,
 "lines": [
  {
   "text": "At two in the morning the wind picked up, and Lena's tent started flapping.",
   "start": 0.4,
   "end": 4.243
  },
  {
   "text": "One stake had pulled out of the soft ground, and a corner was folding in on her.",
   "start": 4.543,
   "end": 8.811
  },
  {
   "text": "Here's the fix.",
   "start": 9.111,
   "end": 10.039
  },
  {
   "text": "Push each stake in at about forty-five degrees, the top leaning away from the tent,",
   "start": 10.439,
   "end": 15.356
  },
  {
   "text": "all the way down so only the hook shows.",
   "start": 15.556,
   "end": 17.665
  },
  {
   "text": "Stake the windward side first, then tighten every guyline.",
   "start": 18.065,
   "end": 21.43
  },
  {
   "text": "Her tent held till morning.",
   "start": 21.83,
   "end": 23.308
  },
  {
   "text": "Save this before your next camp night.",
   "start": 23.908,
   "end": 25.767
  }
 ],
