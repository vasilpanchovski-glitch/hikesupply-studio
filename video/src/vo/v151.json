{
 "duration": 24.99,
 "lines": [
  {
   "text": "Halfway down the icy trail, Kate's boot lace came undone.",
   "start": 0.4,
   "end": 3.783
  },
  {
   "text": "With thick gloves on, she couldn't tie it.",
   "start": 4.083,
   "end": 6.001
  },
  {
   "text": "Gloves off, fingers numb, two long minutes in the wind.",
   "start": 6.301,
   "end": 9.279
  },
  {
   "text": "Here's the fix.",
   "start": 9.579,
   "end": 10.506
  },
  {
   "text": "Tie your boots at the trailhead with warm, bare hands.",
   "start": 10.806,
   "end": 13.779
  },
  {
   "text": "Double knot, then tuck the loops in.",
   "start": 14.079,
   "end": 16.026
  },
  {
   "text": "If your laces are worn smooth or fuzzy, replace them before winter.",
   "start": 16.326,
   "end": 20.296
  },
  {
   "text": "Her laces held all the way down.",
   "start": 20.596,
   "end": 22.435
  },
  {
   "text": "Save this before your next winter hike.",
   "start": 22.935,
   "end": 24.79
  }
 ],
