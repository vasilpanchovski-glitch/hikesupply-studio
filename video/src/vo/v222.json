  {
   "text": "Jake packed shorts for Joshua Tree in January.",
   "start": 0.3,
   "end": 3.008
  },
  {
   "text": "It's a desert, right?",
   "start": 3.058,
   "end": 4.139
  },
  {
   "text": "By sunset he was shivering.",
   "start": 4.239,
   "end": 5.749
  },
  {
   "text": "Winter nights there can drop below freezing.",
   "start": 5.949,
   "end": 8.414
  },
  {
   "text": "Pack a warm jacket, hat and gloves for any hike near dark.",
   "start": 8.514,
   "end": 11.903
  },
