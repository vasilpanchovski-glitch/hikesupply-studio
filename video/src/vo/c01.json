{
 "duration": 24.917,
 "lines": [
  {
   "text": "Jake reached a cold creek, high after the rain.",
   "start": 0.3,
   "end": 3.069
  },
  {
   "text": "He stepped in with his pack buckled tight.",
   "start": 3.269,
   "end": 5.218
  },
  {
   "text": "One slip, and his spare layers got soaked.",
   "start": 5.418,
   "end": 7.803
  },
  {
   "text": "Here's the fix. Cross at a wide, slow, shallow spot.",
   "start": 8.303,
   "end": 11.628
  },
  {
   "text": "Unclip the hip belt so you can drop the pack if you fall.",
   "start": 11.878,
   "end": 14.931
  },
  {
   "text": "Face upstream and use a pole.",
   "start": 15.181,
   "end": 16.912
  },
  {
   "text": "If the water is fast or above your knees, turn back.",
   "start": 17.162,
   "end": 19.968
  },
  {
   "text": "Keep dry layers in a dry bag.",
   "start": 20.468,
   "end": 22.318
  },
  {
   "text": "Save this before your next fall hike.",
   "start": 22.818,
   "end": 24.717
  }
 ],
