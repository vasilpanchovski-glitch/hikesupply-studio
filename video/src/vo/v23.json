{
 "duration": 27.137,
 "lines": [
  {
   "text": "Ana flew to Utah, laced her boots and walked to the start of Angels Landing.",
   "start": 0.3,
   "end": 4.716
  },
  {
   "text": "A ranger turned her back.",
   "start": 4.916,
   "end": 6.281
  },
  {
   "text": "No permit.",
   "start": 6.481,
   "end": 7.306
  },
  {
   "text": "Fall is the best season for Utah's Mighty Five, with cool, clear days, but the famous hikes need planning.",
   "start": 7.706,
   "end": 14.097
  },
  {
   "text": "Here's the fix.",
   "start": 14.397,
   "end": 15.324
  },
  {
   "text": "Enter the permit lottery before you go,",
   "start": 15.624,
   "end": 17.669
  },
  {
   "text": "start early because days are short,",
   "start": 17.819,
   "end": 19.674
  },
  {
   "text": "and check the flash flood forecast before any canyon.",
   "start": 19.824,
   "end": 22.717
  },
  {
   "text": "Ana's next trip went perfectly.",
   "start": 23.117,
   "end": 24.879
  },
  {
   "text": "Save this before your Utah trip.",
   "start": 25.279,
   "end": 26.937
  }
 ],
