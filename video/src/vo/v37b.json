{
 "duration": 27.113,
 "lines": [
  {
   "text": "On a bright, cold morning the trail looked dry.",
   "start": 0.3,
   "end": 2.752
  },
  {
   "text": "Then Jess stepped onto a wooden footbridge in the shade, and her feet shot out from under her.",
   "start": 2.953,
   "end": 7.873
  },
  {
   "text": "Frost stays on bridges, boardwalks and shady rocks after the sun warms the trail.",
   "start": 8.173,
   "end": 13.011
  },
  {
   "text": "Here's the fix. Slow down before shady spots,",
   "start": 13.361,
   "end": 16.18
  },
  {
   "text": "take short, flat-footed steps and keep your hands free.",
   "start": 16.33,
   "end": 19.448
  },
  {
   "text": "If the trail turns to solid ice, turn back.",
   "start": 19.698,
   "end": 22.182
  },
  {
   "text": "Jess crossed the next bridge steady.",
   "start": 22.582,
   "end": 24.382
  },
  {
   "text": "Save this before your first frosty hike.",
   "start": 24.782,
   "end": 26.913
  }
 ],
