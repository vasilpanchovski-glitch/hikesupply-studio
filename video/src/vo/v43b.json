 "lines": [
  {
   "text": "Alex hiked up to Scout Lookout, ready for Angels Landing.",
   "start": 0.3,
   "end": 3.856
  },
  {
   "text": "Then a ranger asked for his permit. He didn't have one.",
   "start": 4.006,
   "end": 7.109
  },
  {
   "text": "The climb from Scout Lookout to the summit needs a permit, all year.",
   "start": 7.259,
   "end": 10.971
  },
  {
   "text": "Here's the fix. Apply on recreation dot gov: the seasonal lottery, or the day-before lottery, which closes at 3 pm.",
   "start": 11.171,
   "end": 19.4
  },
  {
   "text": "No luck? Scout Lookout needs no permit, and the view is huge.",
   "start": 19.6,
   "end": 23.362
  },
  {
   "text": "Next morning, Alex had his permit.",
   "start": 23.612,
   "end": 25.796
  },
  {
   "text": "Save this before your Zion trip.",
   "start": 26.096,
   "end": 27.868
  }
 ],
