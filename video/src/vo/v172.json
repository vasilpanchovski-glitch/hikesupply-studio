  {
   "text": "Dan walked out to Bar Island at low tide.",
   "start": 0.3,
   "end": 2.732
  },
  {
   "text": "He stayed too long, and the sea covered the path.",
   "start": 2.932,
   "end": 5.415
  },
  {
   "text": "The rule: cross only within an hour and a half of low tide,",
   "start": 5.715,
   "end": 9.038
  },
  {
   "text": "and check the tide chart first.",
   "start": 9.188,
   "end": 10.82
  },
  {
   "text": "Save this before Acadia.",
   "start": 11.22,
   "end": 12.716
  }
 ],
