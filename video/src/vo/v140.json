 "lines": [
  {
   "text": "Ella ordered her dad a hiking gift a week before Christmas.",
   "start": 0.4,
   "end": 3.69
  },
  {
   "text": "The tracking said it would arrive on December twenty-ninth.",
   "start": 3.89,
   "end": 6.541
  },
  {
   "text": "He hikes a different state park every month, but he never writes any of it down.",
   "start": 6.741,
   "end": 10.906
  },
  {
   "text": "Here's the fix.",
   "start": 11.106,
   "end": 12.033
  },
  {
   "text": "A printable state parks passport.",
   "start": 12.233,
   "end": 14.08
  },
  {
   "text": "Download it tonight, print it at home, and write his first park day inside.",
   "start": 14.28,
   "end": 18.43
  },
  {
   "text": "On Christmas morning, he colored in his home state.",
   "start": 18.63,
   "end": 21.385
  },
  {
   "text": "Save this for your last-minute gift list.",
   "start": 21.785,
   "end": 23.834
  }
 ],
