{
 "duration": 24.031,
 "lines": [
  {
   "text": "At the windy lookout, Kate pulled off a glove to take a photo and set it on the rock.",
   "start": 0.4,
   "end": 5.11
  },
  {
   "text": "One gust, and it was gone over the edge.",
   "start": 5.41,
   "end": 7.55
  },
  {
   "text": "She hiked down with one bare hand stuffed in her pocket.",
   "start": 7.85,
   "end": 10.87
  },
  {
   "text": "Here's the fix.",
   "start": 11.27,
   "end": 12.197
  },
  {
   "text": "Take gloves off only out of the wind,",
   "start": 12.598,
   "end": 14.489
  },
  {
   "text": "and tuck them inside your jacket, never on the ground.",
   "start": 14.689,
   "end": 17.571
  },
  {
   "text": "Wear thin liners for your phone, and pack a spare pair.",
   "start": 17.971,
   "end": 20.9
  },
  {
   "text": "Save this before your next cold hike.",
   "start": 21.8,
   "end": 23.831
  }
 ],
