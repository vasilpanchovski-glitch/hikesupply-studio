{
 "duration": 24.957,
 "lines": [
  {
   "text": "Fresh snow covered the trail, so Sam followed the footprints ahead of him.",
   "start": 0.4,
   "end": 4.213
  },
  {
   "text": "Easy.",
   "start": 4.663,
   "end": 5.204
  },
  {
   "text": "Until they ended at a frozen creek, nowhere near the trail.",
   "start": 5.654,
   "end": 8.846
  },
  {
   "text": "Someone else had been lost too.",
   "start": 9.296,
   "end": 10.78
  },
  {
   "text": "Sam stopped, stayed calm, and thought.",
   "start": 11.23,
   "end": 13.31
  },
  {
   "text": "He checked his map, found the last blaze he had passed, and walked back to it.",
   "start": 13.76,
   "end": 17.811
  },
  {
   "text": "In snow, follow the blazes and your map, not other people's tracks.",
   "start": 18.261,
   "end": 22.27
  },
  {
   "text": "Save this before your first snowy hike.",
   "start": 22.72,
   "end": 24.757
  }
 ],
