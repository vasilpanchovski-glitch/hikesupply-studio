{
 "duration": 25.875,
 "lines": [
  {
   "text": "Lena's first night out. Warm bag, thin summer pad.",
   "start": 0.3,
   "end": 3.27
  },
  {
   "text": "At two a.m. she's shivering.",
   "start": 3.57,
   "end": 5.374
  },
  {
   "text": "The cold is coming up from the ground,",
   "start": 5.724,
   "end": 7.588
  },
  {
   "text": "and a bag squashed under you can't hold heat.",
   "start": 7.738,
   "end": 9.901
  },
  {
   "text": "Here's the fix. Your pad matters as much as your bag.",
   "start": 10.351,
   "end": 13.482
  },
  {
   "text": "Pick a pad made for cold ground,",
   "start": 13.832,
   "end": 15.626
  },
  {
   "text": "and a bag rated colder than the forecast low.",
   "start": 15.776,
   "end": 18.371
  },
  {
   "text": "Sleep in dry layers and a hat.",
   "start": 18.671,
   "end": 20.498
  },
  {
   "text": "Next time, Lena sleeps till sunrise.",
   "start": 20.998,
   "end": 23.343
  },
  {
   "text": "Save this before your first night out.",
   "start": 23.793,
   "end": 25.675
  }
 ],
