{
 "duration": 24.61,
 "lines": [
  {
   "text": "Leo ran ahead to see the creek.",
   "start": 0.3,
   "end": 1.995
  },
  {
   "text": "When he turned around, the trail looked different, and his dad was gone.",
   "start": 2.195,
   "end": 5.686
  },
  {
   "text": "He wanted to run.",
   "start": 5.936,
   "end": 6.925
  },
  {
   "text": "Here's the fix, taught before the hike.",
   "start": 7.425,
   "end": 9.329
  },
  {
   "text": "If you're lost, stay put and hug a tree.",
   "start": 9.579,
   "end": 11.738
  },
  {
   "text": "Blow your whistle three times, and keep blowing.",
   "start": 11.988,
   "end": 14.458
  },
  {
   "text": "Staying in one place makes you easier to find.",
   "start": 14.708,
   "end": 17.263
  },
  {
   "text": "His dad heard the whistle within minutes.",
   "start": 17.763,
   "end": 19.661
  },
  {
   "text": "Teach your kids these rules at the trailhead.",
   "start": 19.911,
   "end": 22.26
  },
  {
   "text": "Save this for your next family hike.",
   "start": 22.66,
   "end": 24.41
  }
 ],
