{
 "duration": 26.465,
 "lines": [
  {
   "text": "Sam started up the trail before sunrise.",
   "start": 0.3,
   "end": 2.489
  },
  {
   "text": "It was below freezing, and twenty minutes in, his headlamp was already dimming.",
   "start": 2.639,
   "end": 6.826
  },
  {
   "text": "Cold weakens batteries.",
   "start": 7.026,
   "end": 8.465
  },
  {
   "text": "Here's the fix. Charge it full the night before.",
   "start": 8.865,
   "end": 11.514
  },
  {
   "text": "Keep the lamp in an inside pocket, close to your body, until you need it.",
   "start": 11.713,
   "end": 15.985
  },
  {
   "text": "And always carry a backup light.",
   "start": 16.185,
   "end": 17.813
  },
  {
   "text": "Next cold morning: gloves on, sensor mode on, one wave of his hand, and the light came on.",
   "start": 18.213,
   "end": 23.787
  },
  {
   "text": "Save this before your next early start.",
   "start": 24.187,
   "end": 26.265
  }
 ],
