  {
   "text": "Lena counted Mount Rushmore as a national park.",
   "start": 0.3,
   "end": 3.175
  },
  {
   "text": "It's a national memorial.",
   "start": 3.375,
   "end": 4.643
  },
  {
   "text": "The Park Service runs over 400 sites, but only 64 are national parks.",
   "start": 4.943,
   "end": 10.278
  },
  {
   "text": "The rule: check the name on nps.gov before you tick it.",
   "start": 10.528,
   "end": 14.251
  },
  {
   "text": "Save this before your next road trip.",
   "start": 14.551,
   "end": 16.364
  }
