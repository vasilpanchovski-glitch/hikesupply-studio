{
 "duration": 26.518,
 "lines": [
  {
   "text": "Mia loved national parks.",
   "start": 0.3,
   "end": 1.951
  },
  {
   "text": "But every year the trip got pushed back, and in ten years she'd seen only four.",
   "start": 2.151,
   "end": 6.39
  },
  {
   "text": "There are sixty-three.",
   "start": 6.64,
   "end": 7.785
  },
  {
   "text": "Here's the fix. Put every park on one page.",
   "start": 8.285,
   "end": 10.949
  },
  {
   "text": "Circle the next one now, in the off season.",
   "start": 11.199,
   "end": 13.486
  },
  {
   "text": "Pick one easy day hike there, and check the park's page on N P S dot gov for timed entry or reservations.",
   "start": 13.736,
   "end": 21.422
  },
  {
   "text": "By spring, Mia's summer trip was booked.",
   "start": 21.922,
   "end": 24.014
  },
  {
   "text": "Save this while you plan next year.",
   "start": 24.514,
   "end": 26.318
  }
 ],
