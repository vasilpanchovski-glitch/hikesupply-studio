  {
   "text": "Maya planned to refill her bottles inside Joshua Tree.",
   "start": 0.3,
   "end": 3.578
  },
  {
   "text": "There's no water in the park's interior, and cell service is very limited.",
   "start": 3.678,
   "end": 7.758
  },
  {
   "text": "The rule: fill every bottle in town,",
   "start": 8.008,
   "end": 10.156
  },
  {
   "text": "and turn back at half your water.",
   "start": 10.256,
   "end": 11.76
  },
  {
   "text": "Save this before your desert trip.",
   "start": 12.06,
   "end": 13.722
  }
