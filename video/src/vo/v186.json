 "lines": [
  {
   "text": "Emma walked into Johnston Canyon in sneakers.",
   "start": 0.3,
   "end": 2.968
  },
  {
   "text": "In winter the catwalks and the trail can be solid ice beside frozen waterfalls.",
   "start": 3.218,
   "end": 8.145
  },
  {
   "text": "She slid at the first bend.",
   "start": 8.395,
   "end": 9.803
  },
  {
   "text": "The rule: bring ice cleats for the canyon.",
   "start": 10.053,
   "end": 12.357
  },
  {
   "text": "Save this before your Banff winter trip.",
   "start": 12.607,
   "end": 14.489
  }
