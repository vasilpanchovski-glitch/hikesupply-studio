{
 "duration": 25.999,
 "lines": [
  {
   "text": "The trail markers ran out, and Chris started walking faster.",
   "start": 0.3,
   "end": 3.601
  },
  {
   "text": "Then faster.",
   "start": 3.801,
   "end": 4.663
  },
  {
   "text": "Every turn looked the same.",
   "start": 4.863,
   "end": 6.205
  },
  {
   "text": "Panic makes lost hikers more lost.",
   "start": 6.505,
   "end": 8.598
  },
  {
   "text": "Here's the fix.",
   "start": 8.998,
   "end": 9.925
  },
  {
   "text": "Remember STOP.",
   "start": 10.225,
   "end": 11.135
  },
  {
   "text": "Stop moving.",
   "start": 11.435,
   "end": 12.316
  },
  {
   "text": "Think about the last place you knew.",
   "start": 12.516,
   "end": 14.056
  },
  {
   "text": "Observe the sun, the sound of water, your map.",
   "start": 14.256,
   "end": 16.858
  },
  {
   "text": "Plan your next move, and if you're truly lost, stay put and blow your whistle.",
   "start": 17.058,
   "end": 21.127
  },
  {
   "text": "Chris stopped, breathed, and found the trail.",
   "start": 21.527,
   "end": 23.666
  },
  {
   "text": "Save this. It could get you home.",
   "start": 24.066,
   "end": 25.799
  }
 ],
