{
 "duration": 23.785,
 "lines": [
  {
   "text": "Nate's daypack was stuffed with warm layers for a cold November hike,",
   "start": 0.3,
   "end": 4.295
  },
  {
   "text": "so he left his spare bottle in the car.",
   "start": 4.395,
   "end": 6.328
  },
  {
   "text": "By the last climb his only bottle was empty.",
   "start": 6.578,
   "end": 9.313
  },
  {
   "text": "Here's the fix. Carry a collapsible bottle.",
   "start": 9.763,
   "end": 12.232
  },
  {
   "text": "It holds 600 milliliters,",
   "start": 12.482,
   "end": 14.339
  },
  {
   "text": "and once it's empty you squash it flat into a hip-belt pocket.",
   "start": 14.489,
   "end": 17.682
  },
  {
   "text": "Now he carries both the layers and the extra water.",
   "start": 18.082,
   "end": 21.153
  },
  {
   "text": "Save this before your next cold hike.",
   "start": 21.553,
   "end": 23.585
  }
 ],
