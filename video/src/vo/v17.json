{
 "duration": 26.095,
 "lines": [
  {
   "text": "Ben loved October hikes in his dark green jacket.",
   "start": 0.3,
   "end": 3.23
  },
  {
   "text": "Then he heard a shot echo across the valley.",
   "start": 3.53,
   "end": 5.758
  },
  {
   "text": "He froze.",
   "start": 6.058,
   "end": 6.76
  },
  {
   "text": "Fall is hunting season in much of the US and Canada, and many hiking trails cross hunting land.",
   "start": 7.16,
   "end": 12.951
  },
  {
   "text": "Here's the fix.",
   "start": 13.351,
   "end": 14.278
  },
  {
   "text": "Check local season dates before you go,",
   "start": 14.578,
   "end": 16.745
  },
  {
   "text": "wear bright blaze orange on your body and your pack,",
   "start": 16.945,
   "end": 19.68
  },
  {
   "text": "and stay on the marked trail.",
   "start": 19.88,
   "end": 21.221
  },
  {
   "text": "Now Ben is the brightest thing in the woods.",
   "start": 21.621,
   "end": 23.884
  },
  {
   "text": "Save this for your fall hikes.",
   "start": 24.334,
   "end": 25.895
  }
 ],
