 "lines": [
  {
   "text": "Ben's friend pointed at his face: a pale, waxy patch on his cheek.",
   "start": 0.3,
   "end": 4.428
  },
  {
   "text": "He hadn't felt it. That can be early frostnip.",
   "start": 4.678,
   "end": 7.128
  },
  {
   "text": "The rule: check each other's faces, cover up, warm it gently. Never rub it.",
   "start": 7.378,
   "end": 11.891
  },
  {
   "text": "Save this for cold days.",
   "start": 12.141,
   "end": 13.549
  }
 ],
