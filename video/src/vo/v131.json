{
 "duration": 23.592,
 "lines": [
  {
   "text": "Mia pulled her face cover up at the trailhead and kept it there the whole climb.",
   "start": 0.4,
   "end": 4.622
  },
  {
   "text": "Every breath soaked the fleece.",
   "start": 4.972,
   "end": 6.409
  },
  {
   "text": "On the windy ridge, it froze stiff against her chin.",
   "start": 6.759,
   "end": 9.55
  },
  {
   "text": "Here's the fix.",
   "start": 9.95,
   "end": 10.877
  },
  {
   "text": "On the climb, push the face panel down and let your face breathe.",
   "start": 11.177,
   "end": 14.529
  },
  {
   "text": "When the wind hits, pull it up over your nose and snug the hood.",
   "start": 14.829,
   "end": 17.972
  },
  {
   "text": "Mia reached the top with a warm, dry face.",
   "start": 18.472,
   "end": 20.861
  },
  {
   "text": "Save this before your next cold hike.",
   "start": 21.361,
   "end": 23.392
  }
 ],
