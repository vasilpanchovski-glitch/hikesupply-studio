{
 "duration": 24.739,
 "lines": [
  {
   "text": "Dan twisted his ankle four miles from the car, just as the sun dropped.",
   "start": 0.3,
   "end": 4.559
  },
  {
   "text": "Cold October air rolled in, and help was hours away.",
   "start": 4.859,
   "end": 8.13
  },
  {
   "text": "He had no tent and no sleeping bag.",
   "start": 8.43,
   "end": 10.574
  },
  {
   "text": "Then he remembered the tiny pouch at the bottom of his pack.",
   "start": 10.974,
   "end": 13.936
  },
  {
   "text": "An emergency bivy.",
   "start": 14.236,
   "end": 15.484
  },
  {
   "text": "He slid inside, and it trapped his body heat while he waited.",
   "start": 15.784,
   "end": 19.104
  },
  {
   "text": "Rescue came at dawn.",
   "start": 19.504,
   "end": 20.616
  },
  {
   "text": "Dan was cold, but okay.",
   "start": 20.816,
   "end": 22.24
  },
  {
   "text": "Save this before your next fall hike.",
   "start": 22.64,
   "end": 24.539
  }
 ],
