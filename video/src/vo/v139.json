{
 "duration": 23.815,
 "lines": [
  {
   "text": "Ava reached the cold summit tired and slow.",
   "start": 0.4,
   "end": 2.725
  },
  {
   "text": "Her water bottle was still full, buried at the bottom of her pack.",
   "start": 3.105,
   "end": 6.532
  },
  {
   "text": "Cold days hide thirst, so she forgot to drink.",
   "start": 6.912,
   "end": 9.54
  },
  {
   "text": "Here's the fix.",
   "start": 9.92,
   "end": 10.847
  },
  {
   "text": "Carry the bottle at your hip in an insulated sleeve on a strap,",
   "start": 11.227,
   "end": 14.362
  },
  {
   "text": "and take a few sips at every stop.",
   "start": 14.462,
   "end": 16.186
  },
  {
   "text": "The sleeve also slows the water from freezing.",
   "start": 16.566,
   "end": 19.187
  },
  {
   "text": "Ava drank on the way down.",
   "start": 19.567,
   "end": 21.08
  },
  {
   "text": "Save this before your next winter hike.",
   "start": 21.58,
   "end": 23.435
  }
 ],
