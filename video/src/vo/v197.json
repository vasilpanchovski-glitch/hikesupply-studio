 "lines": [
  {
   "text": "Owen saw smooth snow across the trail.",
   "start": 0.3,
   "end": 2.501
  },
  {
   "text": "Underneath, a creek was still running.",
   "start": 2.751,
   "end": 4.646
  },
  {
   "text": "One step and his leg went through into the cold water.",
   "start": 4.896,
   "end": 7.826
  },
  {
   "text": "The rule: never walk on snow over running water.",
   "start": 8.076,
   "end": 10.734
  },
  {
   "text": "Find a solid crossing.",
   "start": 10.984,
   "end": 12.289
  },
  {
   "text": "Save this before your next winter hike.",
   "start": 12.539,
   "end": 14.395
  }
