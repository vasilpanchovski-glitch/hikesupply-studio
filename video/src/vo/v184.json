  {
   "text": "Jake carried ice cleats all morning, saving them for the icy part.",
   "start": 0.3,
   "end": 4.092
  },
  {
   "text": "The ice found him first.",
   "start": 4.342,
   "end": 5.68
  },
  {
   "text": "The rule: when the trail starts to shine, stop and put traction on, before the first slip.",
   "start": 5.93,
   "end": 10.88
  },
  {
   "text": "Save this before your next winter hike.",
   "start": 11.13,
   "end": 12.985
  }
