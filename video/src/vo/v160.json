 "lines": [
  {
   "text": "Nora's hike ended on a dark road, in a dark jacket.",
   "start": 0.3,
   "end": 3.473
  },
  {
   "text": "A truck passed far too close.",
   "start": 3.673,
   "end": 5.271
  },
  {
   "text": "The fix: walk facing traffic, carry a light,",
   "start": 5.571,
   "end": 8.085
  },
  {
   "text": "and wear reflective straps with red lights front and back.",
   "start": 8.235,
   "end": 10.961
  },
  {
   "text": "Save this before your next winter hike.",
   "start": 11.361,
   "end": 13.217
  }
 ],
