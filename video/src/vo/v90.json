{
 "duration": 26.773,
 "lines": [
  {
   "text": "Marco packed for his first overnight like he was moving out.",
   "start": 0.5,
   "end": 3.747
  },
  {
   "text": "Thirty-five pounds for one night.",
   "start": 4.147,
   "end": 5.812
  },
  {
   "text": "By mile two, his shoulders burned.",
   "start": 6.262,
   "end": 8.227
  },
  {
   "text": "Here's the fix. Lay everything out at home and weigh it.",
   "start": 8.777,
   "end": 11.845
  },
  {
   "text": "Write each item down.",
   "start": 12.245,
   "end": 13.493
  },
  {
   "text": "If you didn't use it on day hikes, ask if you need it.",
   "start": 13.893,
   "end": 16.581
  },
  {
   "text": "Borrow or rent the big pieces before you buy.",
   "start": 17.031,
   "end": 19.582
  },
  {
   "text": "Then pack heavy things close to your back.",
   "start": 19.982,
   "end": 21.829
  },
  {
   "text": "Marco made camp smiling.",
   "start": 22.379,
   "end": 23.779
  },
  {
   "text": "Save this before your first backpacking trip.",
   "start": 24.329,
   "end": 26.573
  }
 ],
