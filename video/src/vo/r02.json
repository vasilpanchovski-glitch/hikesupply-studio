 "lines": [
  {
   "text": "Loose rock can slide out from under you.",
   "start": 0.3,
   "end": 2.4
  },
  {
   "text": "On scree, take short steps, keep your weight over your feet and your knees soft.",
   "start": 2.65,
   "end": 6.928
  },
  {
   "text": "Never walk straight below another hiker.",
   "start": 7.128,
   "end": 9.079
  },
  {
   "text": "Poles give you two extra points of contact.",
   "start": 9.329,
   "end": 11.797
  },
  {
   "text": "Save this before your next climb.",
   "start": 12.097,
   "end": 13.813
  }
 ],
