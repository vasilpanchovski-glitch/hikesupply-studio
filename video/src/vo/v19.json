{
 "duration": 25.502,
 "lines": [
  {
   "text": "Leo crossed one muddy stream in his cotton gym socks.",
   "start": 0.3,
   "end": 3.227
  },
  {
   "text": "Ten minutes later his feet were cold, wet and rubbing raw.",
   "start": 3.527,
   "end": 6.896
  },
  {
   "text": "Cotton soaks up water and holds it against your skin.",
   "start": 7.196,
   "end": 10.066
  },
  {
   "text": "A friend handed him a dry pair of merino wool socks.",
   "start": 10.466,
   "end": 13.785
  },
  {
   "text": "Here's the fix.",
   "start": 14.085,
   "end": 15.013
  },
  {
   "text": "Wool stays warmer when damp and pulls sweat away from your feet.",
   "start": 15.313,
   "end": 18.661
  },
  {
   "text": "Pack a spare pair in a dry bag too.",
   "start": 18.961,
   "end": 20.84
  },
  {
   "text": "Leo finished the loop with happy feet.",
   "start": 21.29,
   "end": 23.165
  },
  {
   "text": "Save this before your next hike.",
   "start": 23.615,
   "end": 25.302
  }
 ],
