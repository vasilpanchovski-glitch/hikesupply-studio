{
 "duration": 26.222,
 "lines": [
  {
   "text": "It felt mild in the forest, so Tom left his jacket in the car.",
   "start": 0.3,
   "end": 4.114
  },
  {
   "text": "Then the trail broke out onto the open ridge.",
   "start": 4.414,
   "end": 6.852
  },
  {
   "text": "The wind hit him, and his warm sweaty shirt turned cold in seconds.",
   "start": 7.102,
   "end": 11.076
  },
  {
   "text": "Wind pulls heat off your body fast.",
   "start": 11.326,
   "end": 13.357
  },
  {
   "text": "Here's the fix.",
   "start": 13.707,
   "end": 14.634
  },
  {
   "text": "Carry a light windbreaker.",
   "start": 14.934,
   "end": 16.351
  },
  {
   "text": "It packs small, blocks the wind, and goes on the moment you reach the open ground.",
   "start": 16.551,
   "end": 21.391
  },
  {
   "text": "Tom crossed the next ridge comfortable.",
   "start": 21.791,
   "end": 23.747
  },
  {
   "text": "Save this before your next ridge hike.",
   "start": 24.147,
   "end": 26.022
  }
 ],
