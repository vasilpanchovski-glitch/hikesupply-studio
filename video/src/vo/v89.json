{
 "duration": 25.906,
 "lines": [
  {
   "text": "At the icy stretch, Theo pulls on new slip-on traction for the first time.",
   "start": 0.7,
   "end": 5.019
  },
  {
   "text": "Two steps later, it twists off his heel.",
   "start": 5.469,
   "end": 7.793
  },
  {
   "text": "Here's the fix. Fit traction on your own boots at home,",
   "start": 8.393,
   "end": 11.486
  },
  {
   "text": "with the heel strap pulled fully over the heel.",
   "start": 11.686,
   "end": 13.839
  },
  {
   "text": "Test it on a step.",
   "start": 14.339,
   "end": 15.394
  },
  {
   "text": "Carry it where you can reach it.",
   "start": 15.844,
   "end": 17.279
  },
  {
   "text": "On steep or hard ice, use proper microspikes, or turn back.",
   "start": 17.779,
   "end": 21.446
  },
  {
   "text": "Theo crossed steady.",
   "start": 22.096,
   "end": 23.203
  },
  {
   "text": "Save this before your next icy hike.",
   "start": 23.803,
   "end": 25.706
  }
 ],
