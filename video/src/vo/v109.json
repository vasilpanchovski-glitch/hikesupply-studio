 "lines": [
  {
   "text": "Leo planned his hike around the shortest day of the year.",
   "start": 0.4,
   "end": 3.373
  },
  {
   "text": "Wrong date.",
   "start": 3.823,
   "end": 4.583
  },
  {
   "text": "Across much of the US, the earliest sunsets come in early December, about two weeks before the solstice.",
   "start": 5.033,
   "end": 11.496
  },
  {
   "text": "He was still on the ridge at four thirty when the light went.",
   "start": 11.946,
   "end": 14.751
  },
  {
   "text": "The wind picked up, his face went numb.",
   "start": 15.201,
   "end": 17.26
  },
  {
   "text": "Now he packs three things: a charged headlamp, a neck gaiter for the wind, and a winter plan.",
   "start": 17.71,
   "end": 23.184
  },
  {
   "text": "Save this before your next afternoon hike.",
   "start": 23.634,
   "end": 25.765
  }
 ],
