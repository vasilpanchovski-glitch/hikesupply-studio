  {
   "text": "Ryan cut his hand two miles in.",
   "start": 0.3,
   "end": 2.062
  },
  {
   "text": "The first-aid kit was in the car, as always.",
   "start": 2.512,
   "end": 5.029
  },
  {
   "text": "A kit only counts if it's on you.",
   "start": 5.479,
   "end": 7.246
  },
  {
   "text": "The rule: keep it on the outside of your pack.",
   "start": 7.696,
   "end": 10.063
  },
  {
   "text": "Save this before your next hike.",
   "start": 10.513,
   "end": 12.2
  }
