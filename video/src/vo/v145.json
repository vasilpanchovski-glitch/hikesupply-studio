{
 "duration": 25.396,
 "lines": [
  {
   "text": "Hannah stopped to fix her boot.",
   "start": 0.4,
   "end": 1.854
  },
  {
   "text": "When she looked up, fog had swallowed the trail, and her group with it.",
   "start": 2.004,
   "end": 5.362
  },
  {
   "text": "She shouted. The wind took her voice.",
   "start": 5.562,
   "end": 7.716
  },
  {
   "text": "Here's the fix.",
   "start": 7.916,
   "end": 8.843
  },
  {
   "text": "Every hiker in the group carries a whistle on a pack strap.",
   "start": 9.043,
   "end": 12.145
  },
  {
   "text": "Agree on simple signals before you start: one blast means stop and wait, three means help.",
   "start": 12.345,
   "end": 18.092
  },
  {
   "text": "Then stay where you are.",
   "start": 18.292,
   "end": 19.538
  },
  {
   "text": "Hannah blew once, and one whistle answered from just ahead.",
   "start": 19.738,
   "end": 22.994
  },
  {
   "text": "Save this before your next group hike.",
   "start": 23.394,
   "end": 25.196
  }
 ],
