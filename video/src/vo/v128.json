{
 "duration": 24.392,
 "lines": [
  {
   "text": "Jen felt a hot spot on her heel and slapped on a strip of tape, square corners and all.",
   "start": 0.4,
   "end": 5.26
  },
  {
   "text": "A mile later it had rolled up inside her sock.",
   "start": 5.66,
   "end": 8.013
  },
  {
   "text": "Here's the fix.",
   "start": 8.413,
   "end": 9.34
  },
  {
   "text": "Dry the skin first.",
   "start": 9.64,
   "end": 10.822
  },
  {
   "text": "Cut the tape with the scissors on a small multi-tool, a bit longer than the sore spot,",
   "start": 11.122,
   "end": 15.902
  },
  {
   "text": "and round every corner so nothing catches.",
   "start": 16.052,
   "end": 18.322
  },
  {
   "text": "Press it flat.",
   "start": 18.622,
   "end": 19.527
  },
  {
   "text": "Jen's tape lasted the whole loop.",
   "start": 20.027,
   "end": 21.738
  },
  {
   "text": "Save this before your next long hike.",
   "start": 22.238,
   "end": 24.192
  }
 ],
