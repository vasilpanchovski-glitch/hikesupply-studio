 "lines": [
  {
   "text": "Mark says someday he'll hike a piece of the Appalachian Trail.",
   "start": 0.3,
   "end": 3.444
  },
  {
   "text": "He's said it for ten years.",
   "start": 3.594,
   "end": 4.923
  },
  {
   "text": "The fix: pick one section, set dates, count honest miles per day, and check the permits.",
   "start": 5.223,
   "end": 10.537
  },
  {
   "text": "Now someday has a date.",
   "start": 10.737,
   "end": 12.05
  },
  {
   "text": "Save this before you plan your year.",
   "start": 12.35,
   "end": 14.115
  }
