{
 "duration": 24.949,
 "lines": [
  {
   "text": "Nina's friend slipped on wet leaves and scraped her hand.",
   "start": 0.3,
   "end": 3.476
  },
  {
   "text": "Nina had a first-aid kit, somewhere at the bottom of her pack.",
   "start": 3.676,
   "end": 7.09
  },
  {
   "text": "She dumped everything onto the muddy trail to find it.",
   "start": 7.34,
   "end": 10.133
  },
  {
   "text": "Here's the fix. Keep first aid on the outside, in a pouch you can reach in seconds.",
   "start": 10.833,
   "end": 15.731
  },
  {
   "text": "Tell your group where it is before you start.",
   "start": 15.981,
   "end": 18.212
  },
  {
   "text": "Next time, Nina had it open before her friend sat down.",
   "start": 18.812,
   "end": 22.147
  },
  {
   "text": "Save this before your next group hike.",
   "start": 22.947,
   "end": 24.749
  }
 ],
