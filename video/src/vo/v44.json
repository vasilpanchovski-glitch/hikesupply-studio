{
 "duration": 25.191,
 "lines": [
  {
   "text": "Sam was still on the trail when the sun went down.",
   "start": 0.3,
   "end": 2.899
  },
  {
   "text": "He switched on his phone flashlight.",
   "start": 3.099,
   "end": 4.741
  },
  {
   "text": "One hand on the phone, one on the rocks, and the cold ate his battery fast.",
   "start": 5.041,
   "end": 9.585
  },
  {
   "text": "Twenty percent. His map and his only way to call were dying.",
   "start": 9.785,
   "end": 13.446
  },
  {
   "text": "Here's the fix. Carry a separate light.",
   "start": 14.046,
   "end": 16.146
  },
  {
   "text": "A headlamp keeps both hands free and lights the trail ahead.",
   "start": 16.396,
   "end": 19.719
  },
  {
   "text": "Your phone stays for the map and emergencies.",
   "start": 19.969,
   "end": 22.392
  },
  {
   "text": "Save this before your next fall hike.",
   "start": 23.092,
   "end": 24.991
  }
 ],
