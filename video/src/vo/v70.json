 "lines": [
  {
   "text": "Every December, Leo bought his sister another hiking gadget.",
   "start": 0.3,
   "end": 3.859
  },
  {
   "text": "Every January, it sat in a drawer, still in the box.",
   "start": 4.059,
   "end": 7.217
  },
  {
   "text": "What she wanted was time on the trail together.",
   "start": 7.517,
   "end": 9.792
  },
  {
   "text": "Here's the fix. Give a hike, not a thing.",
   "start": 10.192,
   "end": 12.482
  },
  {
   "text": "Write a coupon: sunrise hike, I drive, I carry the snacks.",
   "start": 12.732,
   "end": 16.518
  },
  {
   "text": "Then plan it together: the trail, a turnaround time, a weather check.",
   "start": 16.768,
   "end": 20.856
  },
  {
   "text": "In January they finally hiked together.",
   "start": 21.256,
   "end": 23.666
  },
  {
   "text": "Save this for your gift list.",
   "start": 24.066,
   "end": 25.492
  }
 ],
