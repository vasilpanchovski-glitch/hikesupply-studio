{
 "duration": 24.213,
 "lines": [
  {
   "text": "Two hours from the trailhead, Sam had to go.",
   "start": 0.4,
   "end": 3.026
  },
  {
   "text": "No toilet anywhere.",
   "start": 3.226,
   "end": 4.346
  },
  {
   "text": "He scraped a shallow hole with his boot heel, right beside the trail.",
   "start": 4.546,
   "end": 8.115
  },
  {
   "text": "Here's the fix.",
   "start": 8.415,
   "end": 9.342
  },
  {
   "text": "Walk about seventy big steps, two hundred feet, away from water, trail and camp.",
   "start": 9.542,
   "end": 14.265
  },
  {
   "text": "Dig a cathole six to eight inches deep with a small trowel.",
   "start": 14.465,
   "end": 17.884
  },
  {
   "text": "Cover it well and pack out your paper.",
   "start": 18.084,
   "end": 20.062
  },
  {
   "text": "The next hiker never knew.",
   "start": 20.262,
   "end": 21.658
  },
  {
   "text": "Save this before your next long hike.",
   "start": 22.058,
   "end": 24.013
  }
 ],
