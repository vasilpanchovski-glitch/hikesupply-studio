{
 "duration": 25.591,
 "lines": [
  {
   "text": "Sara drove to the Smokies for peak fall color and sat in traffic for two hours.",
   "start": 0.3,
   "end": 5.028
  },
  {
   "text": "Every lot was full, and she had no parking tag.",
   "start": 5.328,
   "end": 8.129
  },
  {
   "text": "Here's the fix.",
   "start": 8.529,
   "end": 9.456
  },
  {
   "text": "Buy your parking tag before you arrive,",
   "start": 9.756,
   "end": 11.895
  },
  {
   "text": "because any car parked longer than fifteen minutes needs one.",
   "start": 12.095,
   "end": 15.246
  },
  {
   "text": "Hit the trailhead at sunrise on a weekday,",
   "start": 15.646,
   "end": 17.69
  },
  {
   "text": "when the color is just as bright and the trail is quiet.",
   "start": 17.89,
   "end": 20.924
  },
  {
   "text": "Sara's second trip was pure gold.",
   "start": 21.374,
   "end": 23.213
  },
  {
   "text": "Save this before your Smokies trip.",
   "start": 23.663,
   "end": 25.391
  }
 ],
