{
 "duration": 24.112,
 "lines": [
  {
   "text": "Jake pulled his beanie on at the cold trailhead.",
   "start": 0.4,
   "end": 2.743
  },
  {
   "text": "On the climb, his head got hot and sweaty, so he stuffed the beanie in his pocket.",
   "start": 2.943,
   "end": 7.556
  },
  {
   "text": "Then the ridge wind hit his bare, damp ears.",
   "start": 7.756,
   "end": 10.224
  },
  {
   "text": "Here's the fix.",
   "start": 10.524,
   "end": 11.451
  },
  {
   "text": "On the climb, wear an ear warmer headband.",
   "start": 11.651,
   "end": 14.024
  },
  {
   "text": "It covers your ears and lets heat escape from the top of your head.",
   "start": 14.224,
   "end": 17.627
  },
  {
   "text": "Save the beanie for the stops.",
   "start": 17.827,
   "end": 19.348
  },
  {
   "text": "Jake reached the ridge dry and warm.",
   "start": 19.548,
   "end": 21.481
  },
  {
   "text": "Save this before your next cold hike.",
   "start": 21.881,
   "end": 23.912
  }
 ],
