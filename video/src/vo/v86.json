 "lines": [
  {
   "text": "Hannah planned all five of Utah's national parks in three days.",
   "start": 0.3,
   "end": 3.751
  },
  {
   "text": "She spent most of it in the car,",
   "start": 4.101,
   "end": 5.631
  },
  {
   "text": "and saw each trail for an hour.",
   "start": 5.831,
   "end": 7.402
  },
  {
   "text": "Here's the fix. Plan the drive before the hikes.",
   "start": 7.952,
   "end": 10.666
  },
  {
   "text": "Some of the parks are hours apart,",
   "start": 11.066,
   "end": 12.894
  },
  {
   "text": "so pick two or three for a short trip and stay near each one.",
   "start": 13.094,
   "end": 16.265
  },
  {
   "text": "Save the rest for next time.",
   "start": 16.615,
   "end": 18.097
  },
  {
   "text": "On her next trip, Hannah hiked Bryce at sunrise, no rush.",
   "start": 18.647,
   "end": 22.046
  },
  {
   "text": "Save this before you plan Utah.",
   "start": 22.596,
   "end": 24.297
  }
 ],
