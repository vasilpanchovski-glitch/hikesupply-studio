{
 "duration": 26.548,
 "lines": [
  {
   "text": "Slushy trail, wet boots.",
   "start": 0.4,
   "end": 1.889
  },
  {
   "text": "Mark had a plan: dry socks at the summit.",
   "start": 2.489,
   "end": 5.01
  },
  {
   "text": "He reached into the side pocket.",
   "start": 5.61,
   "end": 7.179
  },
  {
   "text": "The spare socks were soaked through, along with his gloves.",
   "start": 7.779,
   "end": 10.867
  },
  {
   "text": "Snow melting on the pack all morning.",
   "start": 11.467,
   "end": 13.37
  },
  {
   "text": "Now his spares go into a dry bag, rolled shut three times, deep inside the pack.",
   "start": 13.97,
   "end": 19.222
  },
  {
   "text": "At the top, dry socks, dry gloves, warm feet for the walk down.",
   "start": 19.822,
   "end": 23.892
  },
  {
   "text": "Save this before your next winter hike.",
   "start": 24.492,
   "end": 26.348
  }
 ],
