{
 "duration": 24.635,
 "lines": [
  {
   "text": "At a Yellowstone geyser basin, Lena wanted a closer photo",
   "start": 0.3,
   "end": 3.828
  },
  {
   "text": "of a bright blue pool.",
   "start": 3.928,
   "end": 5.155
  },
  {
   "text": "She put one foot over the edge of the boardwalk.",
   "start": 5.405,
   "end": 7.823
  },
  {
   "text": "The ground there can be a thin crust over scalding water.",
   "start": 8.073,
   "end": 11.135
  },
  {
   "text": "Here's the fix. In thermal areas, always stay on the boardwalks and marked trails.",
   "start": 11.585,
   "end": 16.544
  },
  {
   "text": "Keep kids close.",
   "start": 16.794,
   "end": 17.83
  },
  {
   "text": "Lean on your zoom, not your feet.",
   "start": 18.08,
   "end": 19.802
  },
  {
   "text": "Her best photo came from the boardwalk.",
   "start": 20.202,
   "end": 22.11
  },
  {
   "text": "Save this before your Yellowstone trip.",
   "start": 22.51,
   "end": 24.435
  }
 ],
