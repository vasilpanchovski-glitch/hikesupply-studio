 "lines": [
  {
   "text": "Lena zipped her jacket pocket, she thought.",
   "start": 0.3,
   "end": 2.503
  },
  {
   "text": "At the car, no key.",
   "start": 2.753,
   "end": 3.845
  },
  {
   "text": "It was somewhere back on the trail, under the snow.",
   "start": 4.095,
   "end": 6.444
  },
  {
   "text": "The rule: clip the key to a loop inside your pack, never loose in a pocket.",
   "start": 6.694,
   "end": 11.109
  },
  {
   "text": "Save this before your next hike.",
   "start": 11.359,
   "end": 13.047
  }
