 "lines": [
  {
   "text": "Ivy pulled her gaiter over her nose on the climb.",
   "start": 0.3,
   "end": 2.929
  },
  {
   "text": "Her glasses fogged with every breath.",
   "start": 3.179,
   "end": 5.02
  },
  {
   "text": "The rule: on the climb, keep the gaiter below your nose.",
   "start": 5.32,
   "end": 8.341
  },
  {
   "text": "Pull it up when you stop, or turn into the wind.",
   "start": 8.641,
   "end": 10.976
  },
  {
   "text": "Save this for cold days.",
   "start": 11.276,
   "end": 12.685
  }
 ],
