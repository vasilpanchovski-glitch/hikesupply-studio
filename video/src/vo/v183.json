  {
   "text": "Dan planned four miles.",
   "start": 0.3,
   "end": 1.681
  },
  {
   "text": "His two-year-old stopped at the first rock, then every rock after.",
   "start": 1.881,
   "end": 5.601
  },
  {
   "text": "Toddlers hike to the next thing, not the summit.",
   "start": 5.801,
   "end": 8.226
  },
  {
   "text": "The rule: pick a short loop and turn back while they're still happy.",
   "start": 8.476,
   "end": 11.649
  },
  {
   "text": "Save this for your family hike.",
   "start": 11.998,
   "end": 13.586
  }
