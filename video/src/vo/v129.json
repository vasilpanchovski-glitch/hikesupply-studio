{
 "duration": 25.379,
 "lines": [
  {
   "text": "Ana packed cleats for the icy summit.",
   "start": 0.4,
   "end": 2.392
  },
  {
   "text": "She fell before she left the parking lot.",
   "start": 2.742,
   "end": 4.824
  },
  {
   "text": "Trailheads get packed by hundreds of boots,",
   "start": 5.274,
   "end": 7.571
  },
  {
   "text": "melt by day and refreeze at night,",
   "start": 7.721,
   "end": 9.734
  },
  {
   "text": "so they are often the iciest part of the hike.",
   "start": 9.884,
   "end": 12.129
  },
  {
   "text": "Here's the fix.",
   "start": 12.529,
   "end": 13.456
  },
  {
   "text": "Pull your cleats on at the car, toe loop first, then over the heel.",
   "start": 13.756,
   "end": 17.317
  },
  {
   "text": "Take short, flat-footed steps.",
   "start": 17.617,
   "end": 19.357
  },
  {
   "text": "On steep ice, turn back.",
   "start": 19.657,
   "end": 21.182
  },
  {
   "text": "Ana started steady.",
   "start": 21.682,
   "end": 22.824
  },
  {
   "text": "Save this before your next winter hike.",
   "start": 23.324,
   "end": 25.179
  }
 ],
