  {
   "text": "Nina's black lab ran ten steps ahead at dusk and disappeared.",
   "start": 0.3,
   "end": 3.951
  },
  {
   "text": "Dark dog, dark path, she couldn't see him.",
   "start": 4.051,
   "end": 6.363
  },
  {
   "text": "The rule for winter walks: put a light on your dog, not only on you.",
   "start": 6.613,
   "end": 10.415
  },
  {
   "text": "Charge it first.",
   "start": 10.565,
   "end": 11.529
  },
  {
   "text": "Save this for tonight's walk.",
   "start": 11.829,
   "end": 13.335
  }
