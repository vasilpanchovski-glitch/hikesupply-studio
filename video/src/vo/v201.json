  {
   "text": "December twenty-first, the longest night of the year.",
   "start": 0.3,
   "end": 3.103
  },
  {
   "text": "Sam's after-work walk ended on a dark road,",
   "start": 3.353,
   "end": 5.855
  },
  {
   "text": "phone light in hand, black jacket on.",
   "start": 5.955,
   "end": 8.28
  },
  {
   "text": "The rule: after dark, carry a headlamp and wear lights drivers can see.",
   "start": 8.58,
   "end": 12.797
  },
  {
   "text": "Save this for the dark months.",
   "start": 13.097,
   "end": 14.665
  }
