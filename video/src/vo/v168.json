 "lines": [
  {
   "text": "Tom was shoveling eight inches of snow when the wind numbed his face.",
   "start": 0.3,
   "end": 4.174
  },
  {
   "text": "The fix: cover your face and neck.",
   "start": 4.424,
   "end": 6.278
  },
  {
   "text": "His balaclava has an old man's face printed on it, so the neighbors keep waving.",
   "start": 6.478,
   "end": 11.042
  },
  {
   "text": "Save this before the next snow day.",
   "start": 11.342,
   "end": 13.237
  }
