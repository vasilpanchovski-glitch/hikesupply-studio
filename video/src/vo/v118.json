{
 "duration": 25.26,
 "lines": [
  {
   "text": "Sam plants his pole on a muddy switchback, pulls it out, and the rubber tip is gone.",
   "start": 0.4,
   "end": 5.241
  },
  {
   "text": "Rubber caps are made for pavement, rock slabs and boardwalks.",
   "start": 5.841,
   "end": 9.456
  },
  {
   "text": "On mud, snow and loose dirt they slip and get sucked off.",
   "start": 9.956,
   "end": 12.958
  },
  {
   "text": "Here's the fix.",
   "start": 13.558,
   "end": 14.485
  },
  {
   "text": "Pull the caps off at the trailhead, keep them in a pocket, and let the bare metal tip bite in.",
   "start": 14.885,
   "end": 19.942
  },
  {
   "text": "Sam's pole grips every step down.",
   "start": 20.542,
   "end": 22.501
  },
  {
   "text": "Save this before your next muddy hike.",
   "start": 23.101,
   "end": 25.06
  }
 ],
