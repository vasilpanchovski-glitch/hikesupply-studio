 "lines": [
  {
   "text": "Sam's dad always said hiking wasn't for him.",
   "start": 0.3,
   "end": 2.714
  },
  {
   "text": "Too long, too steep, too cold.",
   "start": 2.914,
   "end": 4.591
  },
  {
   "text": "Here's the trick. Sam stopped asking and gave him a coupon instead:",
   "start": 4.941,
   "end": 8.844
  },
  {
   "text": "one short hike, hot chocolate after, Sam drives.",
   "start": 8.994,
   "end": 11.991
  },
  {
   "text": "He picked an easy two-mile loop, checked the weather, and set a turnaround time.",
   "start": 12.291,
   "end": 16.575
  },
  {
   "text": "Halfway round, his dad stopped to look at the lake and said,",
   "start": 16.975,
   "end": 20.068
  },
  {
   "text": "same time next month?",
   "start": 20.218,
   "end": 21.418
  },
  {
   "text": "Save this gift idea for your family.",
   "start": 21.818,
   "end": 23.934
  }
 ],
