{
 "duration": 26.512,
 "lines": [
  {
   "text": "Ava found water, but only a thin trickle over the rocks.",
   "start": 0.5,
   "end": 3.842
  },
  {
   "text": "She knelt with her filter straw and got a mouthful of air and grit.",
   "start": 4.242,
   "end": 7.887
  },
  {
   "text": "A straw only works where the water is deep enough to reach.",
   "start": 8.337,
   "end": 11.273
  },
  {
   "text": "Here's the fix. Carry a bottle.",
   "start": 11.823,
   "end": 13.658
  },
  {
   "text": "Fill it where the water runs clearest.",
   "start": 14.058,
   "end": 15.765
  },
  {
   "text": "Let the grit settle.",
   "start": 16.115,
   "end": 17.135
  },
  {
   "text": "Then drink through the filter.",
   "start": 17.485,
   "end": 18.882
  },
  {
   "text": "Empty, the bottle folds flat into your pocket.",
   "start": 19.332,
   "end": 22.056
  },
  {
   "text": "Ava drank sitting on a rock.",
   "start": 22.606,
   "end": 24.075
  },
  {
   "text": "Save this before your next hike.",
   "start": 24.625,
   "end": 26.312
  }
 ],
