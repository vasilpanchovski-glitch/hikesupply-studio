{
 "duration": 24.494,
 "lines": [
  {
   "text": "Maya zipped her fleece to the chin at the trailhead.",
   "start": 0.3,
   "end": 2.721
  },
  {
   "text": "Twenty minutes up, she was soaked in sweat.",
   "start": 3.021,
   "end": 5.165
  },
  {
   "text": "At the windy summit, that wet shirt turned ice cold.",
   "start": 5.465,
   "end": 8.534
  },
  {
   "text": "An old hiker passed her and grinned.",
   "start": 8.934,
   "end": 10.735
  },
  {
   "text": "Be bold, start cold.",
   "start": 11.035,
   "end": 12.337
  },
  {
   "text": "Begin the climb a little chilly, take layers off before you sweat,",
   "start": 12.737,
   "end": 16.22
  },
  {
   "text": "and put your warm layer back on the moment you stop.",
   "start": 16.42,
   "end": 18.672
  },
  {
   "text": "Next climb, Maya stayed dry and warm on top.",
   "start": 19.122,
   "end": 21.945
  },
  {
   "text": "Save this before your next fall hike.",
   "start": 22.395,
   "end": 24.294
  }
 ],
