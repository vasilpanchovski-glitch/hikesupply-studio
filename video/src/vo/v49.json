{
 "duration": 25.393,
 "lines": [
  {
   "text": "Maya kept her phone in her hip belt pocket on a freezing ridge.",
   "start": 0.3,
   "end": 3.711
  },
  {
   "text": "At the junction she pulled it out for the map.",
   "start": 3.911,
   "end": 5.977
  },
  {
   "text": "Forty percent, then black.",
   "start": 6.177,
   "end": 7.67
  },
  {
   "text": "Cold makes phone batteries drain much faster.",
   "start": 7.97,
   "end": 10.451
  },
  {
   "text": "Here's the fix. Keep your phone in an inside pocket, close to your body.",
   "start": 11.051,
   "end": 15.413
  },
  {
   "text": "Turn on airplane mode when you're not using it,",
   "start": 15.713,
   "end": 18.157
  },
  {
   "text": "and carry a small charged power bank.",
   "start": 18.307,
   "end": 20.21
  },
  {
   "text": "Maya's phone lasted the whole loop.",
   "start": 20.81,
   "end": 22.562
  },
  {
   "text": "Save this before your next cold hike.",
   "start": 23.162,
   "end": 25.193
  }
 ],
