 "lines": [
  {
   "text": "For three years, Sam's phone wallpaper was the same red rock arch in Utah.",
   "start": 0.4,
   "end": 4.915
  },
  {
   "text": "Every spring, he said next year.",
   "start": 5.365,
   "end": 7.185
  },
  {
   "text": "The trip felt too big: five parks, long drives, shuttles and permits.",
   "start": 7.635,
   "end": 12.046
  },
  {
   "text": "So his partner gave him the plan.",
   "start": 12.496,
   "end": 14.214
  },
  {
   "text": "Drive times between the parks, three, five and seven-day routes, and the day hikes ready on his phone.",
   "start": 14.664,
   "end": 21.05
  },
  {
   "text": "Now the trip is on the calendar for spring.",
   "start": 21.5,
   "end": 23.748
  },
  {
   "text": "Save this if Utah is on your list.",
   "start": 24.198,
   "end": 26.147
  }
 ],
