{
 "duration": 24.957,
 "lines": [
  {
   "text": "Nate leaves his water filter in the side pocket on a frosty night.",
   "start": 0.3,
   "end": 4.106
  },
  {
   "text": "By morning, it's frozen solid.",
   "start": 4.356,
   "end": 6.197
  },
  {
   "text": "A filter that freezes while wet can crack inside, and you can't see the damage.",
   "start": 6.497,
   "end": 11.017
  },
  {
   "text": "Here's the fix. Shake it out after use,",
   "start": 11.367,
   "end": 13.646
  },
  {
   "text": "keep it in an inside pocket by day,",
   "start": 13.796,
   "end": 15.946
  },
  {
   "text": "and in your sleeping bag at night.",
   "start": 16.046,
   "end": 17.586
  },
  {
   "text": "If it ever freezes wet, replace it.",
   "start": 17.886,
   "end": 19.827
  },
  {
   "text": "Nate sips filtered stream water by the fire.",
   "start": 20.177,
   "end": 22.551
  },
  {
   "text": "Save this before your next cold trip.",
   "start": 22.851,
   "end": 24.757
  }
 ],
