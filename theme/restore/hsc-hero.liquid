{% comment %} HikeSupply Co. — Hero: asymmetric split-screen, not a centered overlay {% endcomment %}
<style>
  .hsc-hero {
    display: grid;
    grid-template-columns: 63fr 37fr;
    min-height: 90vh;
    background: rgb(var(--hsc-moss-dark));
  }
  .hsc-hero__media {
    position: relative;
    overflow: hidden;
    min-height: 46rem;
  }
  .hsc-hero__media img,
  .hsc-hero__media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hsc-hero__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: rgb(var(--hsc-moss-dark));
    padding: 5rem 4.4rem;
  }
  .hsc-hero__eyebrow {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--hsc-clay-light));
    margin: 0 0 2rem;
  }
  .hsc-hero__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: clamp(3.6rem, 4.6vw, 5.6rem);
    color: #ffffff;
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin: 0 0 2.4rem;
  }
  .hsc-hero__sub {
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.65;
    margin: 0 0 3.6rem;
  }
  .hsc-hero__ctas { display: flex; flex-direction: column; gap: 1.2rem; align-items: flex-start; }
  .hsc-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.4rem;
    width: 100%;
    max-width: 30rem;
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 1.6rem 2.4rem;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }
  .hsc-hero__btn--primary { background: #ffffff; color: rgb(var(--hsc-ink)); border-color: #ffffff; }
  .hsc-hero__btn--primary:hover { background: rgb(var(--hsc-clay)); border-color: rgb(var(--hsc-clay)); color: #fff; }
  .hsc-hero__btn--secondary { background: transparent; color: #ffffff; border-color: rgba(255, 255, 255, 0.35); }
  .hsc-hero__btn--secondary:hover { border-color: #ffffff; }

  @media (max-width: 989px) {
    .hsc-hero { grid-template-columns: 1fr; min-height: 0; }
    .hsc-hero__media { aspect-ratio: 4 / 5; min-height: 0; }
    .hsc-hero__media img { object-position: 85% 50%; }
    .hsc-hero__media video { object-position: 50% 50%; }
    .hsc-hero__heading { font-size: clamp(3.2rem, 9vw, 4.4rem); }
    .hsc-hero__panel { padding: 4.4rem 2.4rem 5.6rem; }
  }
</style>

<section class="hsc-hero">
  <div class="hsc-hero__media">
    {%- if section.settings.bg_video_url != blank -%}
      <video
        class="hsc-hero__video"
        autoplay muted loop playsinline preload="auto"
        poster="{{ section.settings.bg_video_poster }}"
        data-src-desktop="{{ section.settings.bg_video_url }}"
        data-src-mobile="{{ section.settings.bg_video_url_mobile | default: section.settings.bg_video_url }}"
        aria-label="{{ section.settings.heading | escape }}"
      ></video>
      <script>
        (function () {
          var v = document.currentScript.previousElementSibling;
          var mobile = window.matchMedia('(max-width: 989px)').matches;
          v.src = mobile ? v.dataset.srcMobile : v.dataset.srcDesktop;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.pause(); }
          else { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
        })();
      </script>
    {%- elsif section.settings.bg_image != blank -%}
      <img
        src="{{ section.settings.bg_image | image_url: width: 1600 }}"
        srcset="{{ section.settings.bg_image | image_url: width: 900 }} 900w, {{ section.settings.bg_image | image_url: width: 1600 }} 1600w, {{ section.settings.bg_image | image_url: width: 2400 }} 2400w"
        sizes="(min-width: 990px) 63vw, 100vw"
        alt="{{ section.settings.bg_image.alt | default: section.settings.heading | escape }}"
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.bg_image.width }}"
        height="{{ section.settings.bg_image.height }}"
      >
    {%- elsif section.settings.bg_url != blank -%}
      <img src="{{ section.settings.bg_url }}" alt="{{ section.settings.heading | escape }}" loading="eager" fetchpriority="high">
    {%- else -%}
      <img src="{{ 'hsc-hero-trail.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="eager" fetchpriority="high">
    {%- endif -%}
  </div>
  <div class="hsc-hero__panel">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hsc-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="hsc-hero__heading">{{ section.settings.heading }}</h1>
    <p class="hsc-hero__sub">{{ section.settings.subheading }}</p>
    <div class="hsc-hero__ctas">
      {%- if section.settings.btn1_label != blank -%}
        <a href="{{ section.settings.btn1_url | default: '#' }}" class="hsc-hero__btn hsc-hero__btn--primary">{{ section.settings.btn1_label }} <span>&#8594;</span></a>
      {%- endif -%}
      {%- if section.settings.btn2_label != blank -%}
        <a href="{{ section.settings.btn2_url | default: '#' }}" class="hsc-hero__btn hsc-hero__btn--secondary">{{ section.settings.btn2_label }} <span>&#8594;</span></a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HSC Hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "bg_video_url", "label": "Background video URL (mp4, desktop)" },
    { "type": "text", "id": "bg_video_url_mobile", "label": "Background video URL (mp4, mobile)" },
    { "type": "text", "id": "bg_video_poster", "label": "Video poster image URL" },
    { "type": "image_picker", "id": "bg_image", "label": "Media image" },
    {
      "type": "text",
      "id": "bg_url",
      "label": "Media image URL (overrides the bundled default below if set)",
      "info": "Leave blank to use the bundled trail photo (assets/hsc-hero-trail.jpg)."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Est. for the trail" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gear Built for Every Trail" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Premium hiking gear and trail guides for hikers who take the outdoors seriously." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "btn1_label", "label": "Primary button label", "default": "Shop Gear" },
    { "type": "url", "id": "btn1_url", "label": "Primary button link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button label", "default": "Trail Guides" },
    { "type": "url", "id": "btn2_url", "label": "Secondary button link" }
  ],
  "presets": [
    { "name": "HSC Hero" }
  ]
}
{% endschema %}
