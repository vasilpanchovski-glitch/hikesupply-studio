{% comment %} HikeSupply Co. — Hero: full-width photo with a bold condensed headline on it {% endcomment %}
<style>
  .hsc-hero {
    position: relative;
    min-height: 82vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: rgb(var(--hsc-moss-dark));
  }
  .hsc-hero__media { position: absolute; inset: 0; }
  .hsc-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 62%;
  }
  .hsc-hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10, 18, 12, 0.62) 0%, rgba(10, 18, 12, 0.32) 42%, rgba(10, 18, 12, 0) 70%),
                linear-gradient(0deg, rgba(10, 18, 12, 0.45) 0%, rgba(10, 18, 12, 0) 45%);
  }
  .hsc-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 144rem;
    margin: 0 auto;
    padding: 0 6rem 8rem;
  }
  .hsc-hero__heading {
    font-family: var(--font-heading-family);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(5.6rem, 8.4vw, 12rem);
    line-height: 0.9;
    letter-spacing: 0.005em;
    color: #ffffff;
    margin: 0 0 2rem;
    max-width: none;
  }
  .hsc-hero__sub {
    font-family: var(--font-body-family);
    font-size: 1.9rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.5;
    margin: 0 0 3.2rem;
    max-width: 46rem;
  }
  .hsc-hero__ctas { display: flex; flex-wrap: wrap; gap: 1.2rem; }
  .hsc-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20rem;
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 1.7rem 3rem;
    border: 2px solid transparent;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .hsc-hero__btn--primary { background: rgb(var(--hsc-clay)); color: #fff; border-color: rgb(var(--hsc-clay)); }
  .hsc-hero__btn--primary:hover { background: #fff; color: rgb(var(--hsc-ink)); border-color: #fff; }
  .hsc-hero__btn--secondary { background: transparent; color: #fff; border-color: #fff; }
  .hsc-hero__btn--secondary:hover { background: #fff; color: rgb(var(--hsc-ink)); }

  @media (max-width: 989px) {
    .hsc-hero { min-height: 78vh; }
    .hsc-hero__media img { object-position: 82% 50%; }
    .hsc-hero__shade { background: linear-gradient(0deg, rgba(10, 18, 12, 0.78) 0%, rgba(10, 18, 12, 0.35) 45%, rgba(10, 18, 12, 0.05) 75%); }
    .hsc-hero__content { padding: 0 2rem 4.4rem; }
    .hsc-hero__heading { font-size: clamp(4.8rem, 15vw, 7.2rem); }
    .hsc-hero__sub { font-size: 1.6rem; }
    .hsc-hero__btn { flex: 1 1 100%; }
  }
</style>

<section class="hsc-hero">
  <div class="hsc-hero__media">
    {%- if section.settings.bg_image != blank -%}
      <img
        src="{{ section.settings.bg_image | image_url: width: 1800 }}"
        srcset="{{ section.settings.bg_image | image_url: width: 900 }} 900w, {{ section.settings.bg_image | image_url: width: 1400 }} 1400w, {{ section.settings.bg_image | image_url: width: 1800 }} 1800w, {{ section.settings.bg_image | image_url: width: 2600 }} 2600w"
        sizes="100vw"
        alt="{{ section.settings.bg_image.alt | default: section.settings.heading | escape }}"
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.bg_image.width }}"
        height="{{ section.settings.bg_image.height }}"
      >
    {%- elsif section.settings.bg_url != blank -%}
      <img src="{{ section.settings.bg_url }}" alt="{{ section.settings.heading | escape }}" loading="eager" fetchpriority="high">
    {%- else -%}
      <img src="{{ 'hsc-hero-trail.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="eager" fetchpriority="high">
    {%- endif -%}
  </div>
  <div class="hsc-hero__shade"></div>
  <div class="hsc-hero__content">
    <h1 class="hsc-hero__heading">{{ section.settings.heading | escape | replace: ". ", ".<br>" }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="hsc-hero__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="hsc-hero__ctas">
      {%- if section.settings.btn1_label != blank -%}
        <a href="{{ section.settings.btn1_url | default: '#' }}" class="hsc-hero__btn hsc-hero__btn--primary">{{ section.settings.btn1_label }}</a>
      {%- endif -%}
      {%- if section.settings.btn2_label != blank -%}
        <a href="{{ section.settings.btn2_url | default: '#' }}" class="hsc-hero__btn hsc-hero__btn--secondary">{{ section.settings.btn2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HSC Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Media image" },
    { "type": "text", "id": "bg_url", "label": "Media image URL (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (not shown)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gear up. Get out." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "btn1_label", "label": "Primary button label", "default": "Shop Gear" },
    { "type": "url", "id": "btn1_url", "label": "Primary button link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button label", "default": "Trail Guides" },
    { "type": "url", "id": "btn2_url", "label": "Secondary button link" }
  ],
  "presets": [
    { "name": "HSC Hero" }
  ]
}
{% endschema %}
