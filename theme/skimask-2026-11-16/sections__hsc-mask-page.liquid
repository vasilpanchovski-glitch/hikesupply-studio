{%- comment -%}
  Funny Old Man Ski Mask page (Vasil asked 2026-11-16, same build as the socks page). Used by templates/product.mask.json.
  Gallery: our slope photos (Shopify Files skimask-*.jpg) first, then the store photos of the 9 faces.
  Bundle prices match the automatic discounts of the ski mask offer: 2 masks 10% off, 3+ masks 15% off.
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign p = v.price
  assign d2 = p | times: 10 | divided_by: 100
  assign d3 = p | times: 15 | divided_by: 100
  assign each2 = p | minus: d2
  assign each3 = p | minus: d3
  assign short_title = 'Funny Old Man Ski Mask'
  assign life = 'skimask-chairlift.jpg,skimask-goggles.jpg,skimask-helmets.jpg,skimask-skiing.jpg,skimask-masks-on.jpg,skimask-faces.jpg' | split: ','
  assign life_alt = 'A grumpy grandpa on the chairlift|Two skiers in old face masks and goggles|The masks under helmets and goggles|Skiing down the slope in the masks|Old faces on the slope|Masks rolled up: the real faces underneath' | split: '|'
-%}
<script type="application/ld+json">{{ product | structured_data }}</script>
<div class="hss" data-hss>
 <div class="hss-wrap">
  <div class="hss-top">
   <div class="hss-gal">
    <div class="hss-main"><img src="{{ life[0] | file_img_url: '1400x' }}" alt="{{ life_alt[0] }}" width="1400" height="2508" fetchpriority="high" data-hss-main></div>
    <div class="hss-thumbs">
     {%- for f in life -%}
      <button type="button" class="hss-th{% if forloop.first %} on{% endif %}" data-full="{{ f | file_img_url: '1400x' }}" data-alt="{{ life_alt[forloop.index0] | escape }}" aria-label="Show photo {{ forloop.index }}"><img src="{{ f | file_img_url: '240x' }}" alt="" loading="lazy" width="120" height="215"></button>
     {%- endfor -%}
    </div>
   </div>
   <div class="hss-info">
    <h1 class="hss-h1">{{ short_title }}</h1>
    <div class="hss-sub">A printed stretch ski mask that makes you look like grandpa. Covers head, face and neck. One size.</div>
    <div class="hss-stars">No reviews yet · new in our store</div>
    <div class="hss-price"><span data-hss-price>{{ p | money }}</span> <small>per mask · free shipping</small></div>

    <div class="hss-lbl">Face: <b data-hss-colorname>{{ v.option1 }}</b></div>
    <div class="hss-faces">
     {%- for c in product.options_with_values[0].values -%}
      {%- liquid
        assign fimg = nil
        for m in product.media
          if m.alt contains c.name
            assign fimg = m
            break
          endif
        endfor
      -%}
      <button type="button" class="hss-f{% if c.name == v.option1 %} on{% endif %}" data-color="{{ c.name | escape }}" aria-label="{{ c.name | escape }}" title="{{ c.name | escape }}" {% if fimg %}data-full="{{ fimg | image_url: width: 1400 }}"{% endif %}>{% if fimg %}{{ fimg | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}{% endif %}</button>
     {%- endfor -%}
    </div>

    <div class="hss-lbl">Weight</div>
    <div class="hss-sizes">
     {%- for s in product.options_with_values[1].values -%}
      {%- liquid
        if s.name == 'Winter'
          assign wd = 'Warmer, for the cold season'
        else
          assign wd = 'Thinner, for spring and autumn'
        endif
        assign wv = product.variants | where: 'option2', s.name | first
      -%}
      <button type="button" class="hss-s{% if s.name == v.option2 %} on{% endif %}" data-size="{{ s.name | escape }}"><b>{{ s.name }}</b> · {{ wv.price | money }}<br>{{ wd }}</button>
     {%- endfor -%}
    </div>
    <div class="hss-low" data-hss-low></div>

    <div class="hss-lbl">How many masks?</div>
    <div class="hss-bund">
     <button type="button" class="hss-b on" data-q="1"><span class="r"></span><span class="t"><b>1 mask</b><span>For you</span></span><span class="pr" data-pr="1">{{ p | money }}</span></button>
     <button type="button" class="hss-b" data-q="2"><span class="r"></span><span class="t"><b>2 masks · save 10%</b><span>Grandpa and grandma on the lift</span></span><span class="pr" data-pr="2">{{ each2 | times: 2 | money }}<s>{{ p | times: 2 | money }}</s></span></button>
     <button type="button" class="hss-b" data-q="3"><span class="tag">BEST VALUE</span><span class="r"></span><span class="t"><b>3+ masks · save 15%</b><span>The whole ski group · mix any faces</span></span><span class="pr" data-pr="3">{{ each3 | times: 3 | money }}<s>{{ p | times: 3 | money }}</s></span></button>
    </div>
    <div class="hss-note">Mix faces and weights: pick one, add it, then pick the next. The saving is applied automatically in the cart.</div>
    <button type="button" class="hss-btn" data-hss-add>Add to cart · <span data-hss-total>{{ p | money }}</span></button>
    <div class="hss-err" data-hss-err></div>
    <div class="hss-trust"><div><b>Free shipping</b>Tracked, 6–13 business days</div><div><b>30-day returns</b>Changed your mind? Send it back</div><div><b>Secure checkout</b>Shop Pay and cards</div></div>
   </div>
  </div>

  <div class="hss-sec"><h2>Nine faces</h2>
   <div class="hss-grid9">
    {%- for c in product.options_with_values[0].values -%}
     {%- for m in product.media -%}{%- if m.alt contains c.name -%}<button type="button" class="hss-card hss-pick" data-color="{{ c.name | escape }}">{{ m | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 900px) 20vw, 33vw', alt: m.alt }}<div><h3>{{ c.name }}</h3></div></button>{%- break -%}{%- endif -%}{%- endfor -%}
    {%- endfor -%}
   </div>
  </div>

  <div class="hss-sec"><h2>How it wears</h2>
   <div class="hss-why">
    <div class="hss-card"><img src="{{ 'skimask-helmets.jpg' | file_img_url: '800x' }}" alt="Masks under ski helmets and goggles" loading="lazy" class="tall"><div><h3>Under a helmet</h3><p>Thin enough to sit under a ski helmet. The wide eye opening fits goggles or sunglasses.</p></div></div>
    <div class="hss-card"><img src="{{ 'skimask-masks-on.jpg' | file_img_url: '800x' }}" alt="Two people in the masks on the slope" loading="lazy" class="tall"><div><h3>Head, face and neck</h3><p>One piece of printed stretch fabric. The long neck tucks into your jacket collar.</p></div></div>
    <div class="hss-card"><img src="{{ 'skimask-faces.jpg' | file_img_url: '800x' }}" alt="Masks rolled up on the forehead" loading="lazy" class="tall"><div><h3>Easy on, easy off</h3><p>Roll it up for lunch or the photo reveal, pull it down for the next run.</p></div></div>
   </div>
  </div>

  <div class="hss-two">
   <div class="hss-sec"><h2>Winter or Lightweight?</h2>
    <table class="hss-t"><tr><th></th><th class="us">Winter</th><th>Lightweight</th></tr>
     <tr><td>Best for</td><td class="us">Cold ski days</td><td>Spring, autumn, parties</td></tr>
     <tr><td>Fabric</td><td class="us">Warmer printed polyester</td><td>Thinner printed polyester</td></tr>
     <tr><td>Price</td><td class="us">$19.99</td><td>$17.99</td></tr></table>
    <p class="hss-small">Both are thin printed masks, not thick fleece. In deep cold or strong wind, wear a hood or a warm layer with it.</p>
   </div>
   <div class="hss-sec"><h2>Size</h2>
    <div class="hss-sz"><div class="row"><b>Height</b><span>43 cm · 16.9 in</span></div><div class="row"><b>Width, laid flat</b><span>26 cm · 10.2 in</span></div><div class="row"><span>One stretchy size that fits most adults. Sold as one mask. Goggles not included.</span></div></div>
   </div>
  </div>

  <div class="hss-sec"><h2>Reviews</h2><div class="hss-rev">No reviews yet. These masks are new in our store.</div></div>

  <div class="hss-sec"><h2>Questions</h2><div class="hss-faq">
   <div><b>Is it one mask or a set?</b><span>One mask per item. Choose 2 or 3+ above to save, and mix any faces.</span></div>
   <div><b>Is it warm?</b><span>It is a thin printed layer. Winter is the warmer of the two. On very cold days add a hood or warm layer.</span></div>
   <div><b>Does it fit under a helmet with goggles?</b><span>Yes. It is thin enough for a helmet and the eye opening fits goggles.</span></div>
   <div><b>How do I wash it?</b><span>Hand wash cold and air dry. No bleach, no dryer, no iron on the print.</span></div>
   <div><b>When will it arrive?</b><span>Ships in 1–3 business days, then arrives in 6–13 business days, with tracking.</span></div>
  </div></div>
 </div>

 <div class="hss-sticky"><img src="{{ product.featured_media | image_url: width: 120 }}" alt="" width="44" height="44"><div class="x"><b>Funny Old Man Ski Mask</b><br><span data-hss-stickytxt>1 mask · {{ p | money }}</span></div><button type="button" data-hss-add>Add to cart</button></div>
</div>

<script type="application/json" data-hss-variants>[
{%- for x in product.variants -%}{"id":{{ x.id }},"c":{{ x.option1 | json }},"s":{{ x.option2 | json }},"a":{{ x.available | json }},"p":{{ x.price }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}
]</script>
<script type="application/json" data-hss-money>{{ shop.money_format | json }}</script>

<style>
.hss{--bg:#F6F7F4;--stone:#ECEEE9;--ink:#17291C;--forest:#203325;--clay:#9E4421;--line:#d7dbd2;background:var(--bg);color:var(--ink);font-size:15px;line-height:1.5}
.hss *{box-sizing:border-box}
.hss h1,.hss h2,.hss h3,.hss .hss-b .t b,.hss-price,.hss-btn,.hss-t th,.hss-sticky b,.hss-sticky button{font-family:var(--font-heading-family);text-transform:uppercase;letter-spacing:.5px}
.hss-wrap{max-width:1180px;margin:0 auto;padding:0 16px 30px}
.hss-top{display:grid;grid-template-columns:1fr;gap:18px;padding-top:16px}
.hss-main{background:#e7ecef;border-radius:6px;overflow:hidden;aspect-ratio:4/5}
.hss-main img{width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block}
.hss-thumbs{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-top:8px}
.hss-th{padding:0;border:1px solid var(--line);border-radius:4px;overflow:hidden;background:none;cursor:pointer;aspect-ratio:1}
.hss-th img{width:100%;height:100%;object-fit:cover;display:block}
.hss-th.on{border:2px solid var(--ink)}
.hss-h1{font-weight:800;font-size:34px;line-height:1.02;margin:0}
.hss-sub{color:#3c4a3f;margin-top:6px}
.hss-stars{font-size:13px;color:#5b665d;margin-top:8px}
.hss-price{font-weight:800;font-size:30px;color:var(--clay);margin-top:10px}
.hss-price small{font-family:var(--font-body-family);font-weight:400;font-size:13px;color:#3c4a3f;margin-left:8px;text-transform:none;letter-spacing:0}
.hss-lbl{font-size:13px;color:#4a564d;margin:16px 0 8px}
.hss-faces{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.hss-f{padding:0;aspect-ratio:1;border-radius:50%;overflow:hidden;border:2px solid #fff;box-shadow:0 0 0 1px var(--line);background:#f3e7da;cursor:pointer}
.hss-f img{width:100%;height:100%;object-fit:cover;transform:scale(1.35);display:block}
.hss-f.on{box-shadow:0 0 0 2px var(--ink)}
.hss-f.out{opacity:.35}
.hss-sizes{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.hss-s{border:1px solid #9aa39b;border-radius:4px;padding:9px 10px;font-size:13px;line-height:1.3;text-align:left;background:transparent;color:var(--ink);cursor:pointer;font-family:inherit}
.hss-s.on{border:2px solid var(--ink);background:#fff;padding:8px 9px}
.hss-s.out{opacity:.45;text-decoration:line-through}
.hss-s b{font-size:14px}
.hss-low{font-size:12px;color:#7a3b20;margin-top:6px;min-height:1px}
.hss-bund{display:grid;gap:8px}
.hss-b{display:flex;align-items:center;gap:12px;border:1px solid #9aa39b;border-radius:6px;padding:12px;background:#fff;position:relative;cursor:pointer;text-align:left;color:var(--ink);font-family:inherit;width:100%}
.hss-b.on{border:2px solid var(--ink);padding:11px}
.hss-b .r{width:18px;height:18px;border-radius:50%;border:2px solid var(--ink);flex:none}
.hss-b.on .r{background:radial-gradient(var(--ink) 45%,#fff 50%)}
.hss-b .t{flex:1;display:flex;flex-direction:column}
.hss-b .t b{font-size:19px;font-weight:700}
.hss-b .t span{font-size:12px;color:#4a564d}
.hss-b .pr{text-align:right;font-family:var(--font-heading-family);font-weight:700;font-size:20px}
.hss-b .pr s{display:block;font-family:var(--font-body-family);font-weight:400;font-size:12px;color:#7b857d}
.hss-b .tag{position:absolute;top:-9px;left:12px;background:var(--forest);color:#fff;font-size:11px;padding:1px 8px;border-radius:3px;letter-spacing:.4px}
.hss-note{font-size:11px;color:#7b857d;margin-top:6px}
.hss-btn{display:block;width:100%;text-align:center;background:var(--clay);color:#fff;font-weight:700;font-size:20px;letter-spacing:.6px;padding:14px;border-radius:4px;margin-top:16px;border:0;cursor:pointer}
.hss-btn[disabled]{background:#9aa39b;cursor:not-allowed}
.hss-err{font-size:13px;color:#7a3b20;margin-top:6px}
.hss-trust{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px}
.hss-trust div{background:var(--stone);border-radius:4px;padding:10px 8px;font-size:12px;text-align:center;line-height:1.3}
.hss-trust b{display:block;font-size:13px}
.hss-sec{padding:34px 0 6px}
.hss-sec h2{font-weight:800;font-size:30px;line-height:1.05;margin:0 0 14px}
.hss-why{display:grid;grid-template-columns:1fr;gap:14px}
.hss-grid9{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.hss-card{background:#fff;border:1px solid var(--line);border-radius:6px;overflow:hidden;padding:0;text-align:left;color:var(--ink);font-family:inherit}
.hss-pick{cursor:pointer}
.hss-card img{width:100%;aspect-ratio:1;object-fit:cover;display:block;height:auto}
.hss-card img.tall{aspect-ratio:4/5;object-position:center 35%}
.hss-card div{padding:10px 12px}
.hss-card h3{font-weight:700;font-size:17px;margin:0}
.hss-why .hss-card h3{font-size:21px}
.hss-card p{font-size:14px;color:#33413a;margin:4px 0 0}
.hss-t{width:100%;border-collapse:collapse;background:#fff;font-size:14px}
.hss-t th,.hss-t td{padding:10px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
.hss-t th{font-weight:700;font-size:16px}
.hss-t td:first-child{color:#4a564d;width:34%}
.hss-t .us{background:#eef1e9;font-weight:600}
.hss-small{font-size:13px;color:#4a564d;margin-top:10px}
.hss-sz{background:#fff;border:1px solid var(--line);border-radius:6px;padding:14px}
.hss-sz .row{display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px solid var(--line);font-size:14px}
.hss-sz .row:last-child{border:0}
.hss-rev{background:#fff;border:1px dashed #9aa39b;border-radius:6px;padding:18px;text-align:center;font-size:14px;color:#3c4a3f}
.hss-faq div{border-bottom:1px solid var(--line);padding:12px 0}
.hss-faq b{display:block;font-size:15px}
.hss-faq span{font-size:14px;color:#33413a}
.hss-sticky{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#fff;border-top:1px solid var(--line);display:flex;align-items:center;gap:12px;padding:10px 16px;transform:translateY(110%);transition:transform .2s}
.hss-sticky.show{transform:none}
.hss-sticky img{width:44px;height:44px;border-radius:4px;object-fit:cover}
.hss-sticky .x{flex:1;font-size:13px;line-height:1.25}
.hss-sticky b{font-size:17px}
.hss-sticky button{background:var(--clay);color:#fff;font-weight:700;font-size:17px;padding:10px 16px;border-radius:4px;border:0;cursor:pointer}
@media(min-width:900px){
 .hss-top{grid-template-columns:1.1fr 1fr;gap:44px;padding-top:28px}
 .hss-gal{position:sticky;top:100px;align-self:start}
 .hss-h1{font-size:46px}
 .hss-why{grid-template-columns:repeat(3,1fr)}
 .hss-grid9{grid-template-columns:repeat(5,1fr)}
 .hss-two{display:grid;grid-template-columns:1fr 1fr;gap:36px}
 .hss-sticky{display:none}
}
</style>
<script>
(function(){
 var root=document.querySelector('[data-hss]'); if(!root) return;
 var V=JSON.parse(root.parentNode.querySelector('[data-hss-variants]').textContent);
 var state={c:{{ v.option1 | json }},s:{{ v.option2 | json }},q:1};
 var mainImg=root.querySelector('[data-hss-main]');
 function money(c){ return '$'+(c/100).toFixed(2); }
 function show(src,alt){ if(!src) return; mainImg.removeAttribute('srcset'); mainImg.src=src; if(alt!=null) mainImg.alt=alt; }
 function cur(){ for(var i=0;i<V.length;i++){ if(V[i].c===state.c&&V[i].s===state.s) return V[i]; } return null; }
 function prices(v){ var p=v?v.p:0; var e2=p-Math.floor(p*10/100), e3=p-Math.floor(p*15/100); return {1:[p,0],2:[e2*2,p*2],3:[e3*3,p*3]}; }
 function render(){
  var v=cur(), P=prices(v);
  root.querySelector('[data-hss-colorname]').textContent=state.c;
  root.querySelectorAll('.hss-f').forEach(function(e){ e.classList.toggle('on',e.dataset.color===state.c); var any=V.some(function(x){return x.c===e.dataset.color&&x.a}); e.classList.toggle('out',!any); });
  root.querySelectorAll('.hss-s').forEach(function(e){ e.classList.toggle('on',e.dataset.size===state.s); var x=V.filter(function(y){return y.c===state.c&&y.s===e.dataset.size})[0]; e.classList.toggle('out',!x||!x.a); });
  root.querySelectorAll('.hss-b').forEach(function(e){ var q=+e.dataset.q; e.classList.toggle('on',q===state.q); var pr=e.querySelector('[data-pr]'); if(v){ pr.innerHTML=money(P[q][0])+(P[q][1]?'<s>'+money(P[q][1])+'</s>':''); } });
  if(v) root.querySelector('[data-hss-price]').textContent=money(v.p);
  var btns=root.querySelectorAll('[data-hss-add]'), total=v?money(P[state.q][0]):'';
  if(!v||!v.a){ btns.forEach(function(b){b.disabled=true}); root.querySelector('.hss-btn').textContent='Sold out in this face and weight'; }
  else { btns.forEach(function(b){b.disabled=false}); root.querySelector('.hss-btn').innerHTML='Add to cart · <span data-hss-total>'+total+'</span>'; }
  root.querySelector('[data-hss-stickytxt]').textContent=state.q+(state.q===1?' mask':' masks')+' · '+total;
  if(v){ var u=new URL(location.href); u.searchParams.set('variant',v.id); history.replaceState(null,'',u.toString()); }
 }
 root.querySelectorAll('.hss-th').forEach(function(t){ t.addEventListener('click',function(){ root.querySelectorAll('.hss-th').forEach(function(x){x.classList.remove('on')}); t.classList.add('on'); show(t.dataset.full,t.dataset.alt); }); });
 function pickFace(name,el){ state.c=name; render(); var f=root.querySelector('.hss-f[data-color="'+name.replace(/"/g,'\\"')+'"]'); if(f&&f.dataset.full){ show(f.dataset.full,name+' ski mask'); root.querySelectorAll('.hss-th').forEach(function(x){x.classList.remove('on')}); } }
 root.querySelectorAll('.hss-f').forEach(function(e){ e.addEventListener('click',function(){ pickFace(e.dataset.color); }); });
 root.querySelectorAll('.hss-pick').forEach(function(e){ e.addEventListener('click',function(){ pickFace(e.dataset.color); root.querySelector('.hss-info').scrollIntoView({behavior:'smooth',block:'start'}); }); });
 root.querySelectorAll('.hss-s').forEach(function(e){ e.addEventListener('click',function(){ state.s=e.dataset.size; render(); }); });
 root.querySelectorAll('.hss-b').forEach(function(e){ e.addEventListener('click',function(){ state.q=+e.dataset.q; render(); }); });
 root.querySelectorAll('[data-hss-add]').forEach(function(b){ b.addEventListener('click',function(){
  var v=cur(); if(!v||!v.a) return; var err=root.querySelector('[data-hss-err]'); err.textContent='';
  b.disabled=true;
  fetch((window.routes&&window.routes.cart_add_url?window.routes.cart_add_url:'/cart/add')+'.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:v.id,quantity:state.q}]})})
   .then(function(r){return r.json().then(function(j){return {ok:r.ok,j:j}})})
   .then(function(res){ if(!res.ok){ b.disabled=false; err.textContent=res.j.description||res.j.message||'Could not add to cart.'; return; } location.href=(window.routes&&window.routes.cart_url)||'/cart'; })
   .catch(function(){ b.disabled=false; err.textContent='Could not add to cart. Please try again.'; });
 }); });
 var mainBtn=root.querySelector('.hss-btn'), sticky=root.querySelector('.hss-sticky');
 if('IntersectionObserver' in window){ new IntersectionObserver(function(es){ sticky.classList.toggle('show',!es[0].isIntersecting && es[0].boundingClientRect.top<0); }).observe(mainBtn); }
 var pv=new URLSearchParams(location.search).get('variant');
 if(pv){ var m=V.filter(function(x){return String(x.id)===pv})[0]; if(m){ state.c=m.c; state.s=m.s; } }
 render();
})();
</script>

{% schema %}
{
  "name": "HSC ski mask page",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
